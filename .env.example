APP_ENV=development
APP_TIMEZONE=Europe/Istanbul
DELIVERY_MODE=disabled
# Zamanlanmış GitHub taramalarının ayrı güvenlik kapısı: shadow | live.
SCAN_DELIVERY_MODE=shadow
# Gerçek legacy TECHNICAL kodunu aynı snapshot üzerinde paralel çalıştırır.
ENABLE_SHADOW_PARITY=false
# Haber workflow'u için bağımsız yayın kapısı.
NEWS_DELIVERY_MODE=disabled
# Legacy geçiş adapter'larının repo kökü; konteynerde /app.
BORSAPP_REPOSITORY_ROOT=
BORSAPP_ARTIFACT_ROOT=runtime_artifacts
DATABASE_URL=postgresql://borsapp:borsapp@localhost:5432/borsapp
# Docker Compose içindeki servisler için; harici DB kullanılacaksa değiştirin.
COMPOSE_DATABASE_URL=postgresql://borsapp:borsapp@postgres:5432/borsapp

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_CHAT_ADMINS=false
TELEGRAM_ALLOW_CHAT_MEMBERS=false
TELEGRAM_TOPIC_COMMAND=
TELEGRAM_TOPIC_SCANS=
TELEGRAM_TOPIC_ANALYSIS=
TELEGRAM_TOPIC_CHARTS=
TELEGRAM_TOPIC_NEWS=
TELEGRAM_TOPIC_CALENDAR=
TELEGRAM_TOPIC_REPORTS=
TELEGRAM_TOPIC_SYSTEM=
