DATABASE_URL=postgresql://borsapp:CHANGE_ME@localhost:5432/borsapp
COMPOSE_DATABASE_URL=postgresql://borsapp:CHANGE_ME@postgres:5432/borsapp

TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
TELEGRAM_ALLOWED_USERS=1087968824
TELEGRAM_ALLOW_CHAT_ADMINS=false
TELEGRAM_ALLOW_CHAT_MEMBERS=false
TELEGRAM_TOPIC_COMMAND=4
