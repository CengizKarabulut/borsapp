APP_ENV=production
APP_TIMEZONE=Europe/Istanbul
DELIVERY_MODE=live
SCAN_DELIVERY_MODE=live
NEWS_DELIVERY_MODE=live
ENABLE_SHADOW_PARITY=false
BORSAPP_REPOSITORY_ROOT=/app
BORSAPP_ARTIFACT_ROOT=/app/runtime_artifacts

POSTGRES_DB=borsapp
