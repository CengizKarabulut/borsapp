f_cal_closed_atr(int requestedBars) =>
    // Match Python: trim the scan window first, then remove its unfinished bar.
    // Source time is reliable inside request.security; chart confirmation state is not.
    int skip = not na(time_close) and time_close > timenow ? 1 : 0
    int count = math.min(requestedBars, bar_index + 1) - skip
    float result = na
    float seed = 0.0
    bool valid = true
    if count >= 15
        for i = 1 to count - 1
            int offset = skip + count - 1 - i
            float h = high[offset]
            float l = low[offset]
            float previous = close[offset + 1]
            valid := valid and not na(h) and not na(l) and not na(previous) and h > 0.0 and l > 0.0 and previous > 0.0
            float tr = math.max(h - l, math.abs(h - previous), math.abs(l - previous))
            if i <= 14
                seed += tr
            if i == 14
                result := seed / 14.0
            else if i > 14
                result := (result * 13.0 + tr) / 14.0
    valid and result > 0.0 ? result : na

f_cal_plan(int rule, bool up, float atr, float legacyStop, float legacyTp1, float legacyTp2, float legacyTp3) =>
    float s = legacyStop
    float t1 = legacyTp1
    float t2 = legacyTp2
    float t3 = legacyTp3
    [sa, m1, m2, m3] = f_cal_spec(syminfo.ticker, f_atc_tf(), rule, up)
    if calibratedLevelsEnabled and not na(sa) and not na(atr) and atr > 0.0 and close > 0.0
        float direction = up ? 1.0 : -1.0
        float cs = close - direction * atr * sa
        float c1 = close + direction * atr * m1
        float c2 = close + direction * atr * m2
        float c3 = close + direction * atr * m3
        bool valid = cs > 0.0 and c1 > 0.0 and c2 > 0.0 and c3 > 0.0 and (up ? cs < close and close < c1 and c1 < c2 and c2 < c3 : c3 < c2 and c2 < c1 and c1 < close and close < cs)
        if valid
            s := cs
            t1 := c1
            t2 := c2
            t3 := c3
    [s, t1, t2, t3]
// END GENERATED CAL-20261018
f_atc_best_plan(int mask, array<float> nativePlans, array<float> genericPlans, bool up, float calibratedAtr) =>
    int primary = 0
    float stop = na
    float tp1 = na
    float tp2 = na
    float tp3 = na
    float nearest = na
    if f_atc_count(mask) >= 2
        for id = 1 to 18
            if f_atc_bit(mask, id)
                array<float> plans = id <= 9 or id >= 17 ? nativePlans : genericPlans
                int slot = up ? 0 : 4
                [s, t1, t2, t3] = f_cal_plan(id, up, calibratedAtr, array.get(plans, slot), array.get(plans, slot + 1), array.get(plans, slot + 2), array.get(plans, slot + 3))
                bool valid = close > 0 and s > 0 and t1 > 0 and t2 > 0 and t3 > 0 and (up ? s < close and close < t1 and t1 < t2 and t2 < t3 : t3 < t2 and t2 < t1 and t1 < close and close < s)
                float distance = math.abs(close - s) + math.abs(t1 - close)
                if valid and (primary == 0 or distance < nearest)
                    primary := id
                    stop := s
                    tp1 := t1
                    tp2 := t2
                    tp3 := t3
                    nearest := distance
    [primary, stop, tp1, tp2, tp3]

f_atc_state() =>
    // Bounded Rule17 returns unavailable outside daily/recent source contexts.
    [r17Ready, r17Entry, r17Score, r17Setup, r17New, r17Vol, r17Pct, r17Adx, r17Guard, r17Base] = f_r17_frame(atcBars)
    [r17BearReady, r17BearEntry, r17BearScore, r17BearSetup, r17BearNew, r17BearVol, r17BearPct, r17BearAdx, r17BearGuard, r17BearBase] = f_r17_bear_frame(atcBars)
    int bull = 0
    int bear = 0
    int neutral = 0
    int known = 0
    array<float> nativePlans = array.new<float>(8, na)
    array<float> genericPlans = array.new<float>(8, na)
    // Evaluate native 1-9 only on the final source bars. This is a live
    // packet optimization; it does not change the requested history window.
    if last_bar_index - bar_index <= 2
        [legacyFlags, legacyDirs, legacyKnown, legacyPlans] = f_native_legacy_snapshot(atcBars)
        for i = 0 to 8
            int bit = int(math.pow(2.0, i))
            if array.get(legacyKnown, i)
                known += bit
            if array.get(legacyFlags, i)
                if array.get(legacyDirs, i) > 0
                    bull += bit
                else if array.get(legacyDirs, i) < 0
                    bear += bit
        nativePlans := legacyPlans
    // Rules 10-16 are opt-in because their bounded profile/divergence pass is
    // considerably more expensive. Their own known mask remains separate.
    if atcComplex and last_bar_index - bar_index <= 2
        [flags, dirs, available, metrics, plans] = f_r1016_snapshot(atcBars)
        [matched, longMask, shortMask, neutralMask, knownMask] = f_r1016_masks(flags, dirs, available, true)
        bull += longMask
        bear += shortMask
        neutral += neutralMask
        known += knownMask
        genericPlans := plans
    if atcComplex and r17Ready
        known += 65536
        if r17Entry
            bull += 65536
        if r17BearReady and r17BearEntry
            bear += 65536
    // Rule18 requires 112 historical qualifications. Compute only the newest
    // source pair consumed by f_atc_select; include one unfinished source
    // bar for weekly sessions and preserve the full requested frame.
    if atcR18 and last_bar_index - bar_index <= 2
        [r18Known, r18Bull, r18Bear, r18Researched, r18RoundingAmbiguous] = f_r18_native_snapshot(atcBars)
        if r18Known
            known += 131072
            if r18Bull
                bull += 131072
            if r18Bear
                bear += 131072
    bull := directionMode == "Yalnız SAT" ? 0 : bull
    bear := directionMode == "Yalnız AL" ? 0 : bear
    string frame = f_atc_tf()
    // One shared ATR pass only on the final source bars that can be transported.
    float calibratedAtr = na
    if calibratedLevelsEnabled and last_bar_index - bar_index <= 2 and (f_atc_count(bull) >= 2 or f_atc_count(bear) >= 2)
        calibratedAtr := f_cal_closed_atr(atcBars)
    [longPrimary, longStop, longTp1, longTp2, longTp3] = f_atc_best_plan(bull, nativePlans, genericPlans, true, calibratedAtr)
    [shortPrimary, shortStop, shortTp1, shortTp2, shortTp3] = f_atc_best_plan(bear, nativePlans, genericPlans, false, calibratedAtr)
    bool longPlan = longPrimary > 0
    int primary = longPlan ? longPrimary : shortPrimary
    float stop = longPlan ? longStop : shortStop
    float tp1 = longPlan ? longTp1 : shortTp1
    bool validPlan = primary > 0
    string planJson = "null"
    if validPlan
        string planId = "PINE10:" + syminfo.ticker + ":" + frame + ":" + str.tostring(time_close) + ":" + str.tostring(primary)
        planJson := '{"source_plan_id":"' + planId + '","scanner_id":' + str.tostring(primary) + ',"direction":"' + (longPlan ? "long" : "short") + '","entry":' + str.tostring(close, "#.########") + ',"stop":' + str.tostring(stop, "#.########") + ',"tp1":' + str.tostring(tp1, "#.########") + ',"currency":"TRY","bar_close":"' + f_atc_stamp(time_close) + '"}'
    string frameJson = known > 0 and not na(time_close) ? '{"timeframe":"' + frame + '","bar_open":"' + f_atc_stamp(time) + '","bar_close":"' + f_atc_stamp(time_close) + '","bar_confirmed":' + (time_close <= timenow ? "true" : "false") + ',"bullish_ids":' + f_atc_ids(bull) + ',"bearish_ids":' + f_atc_ids(bear) + ',"neutral_ids":' + f_atc_ids(neutral) + ',"evaluated_ids":' + f_atc_ids(known) + ',"plan":' + planJson + '}' : ""
    [frameJson, time_close, bull, bear, neutral, known, longPrimary, longStop, longTp1, longTp2, longTp3, shortPrimary, shortStop, shortTp1, shortTp2, shortTp3]

type AtcPacket
    string json
    int endTime
    int openTime
    string sourceId
    string sourcePrefix
    string sourceTicker
    string currency
    float price
    float volume
    int bull
    int bear
    int neutral
    int known
    bool stock
    string sourceType
    int primary
    float planStop
    float planTp1
    float planTp2
    float planTp3
    int shortPrimary
    float shortStop
    float shortTp1
    float shortTp2
    float shortTp3
type AtcPair
    AtcPacket current
    AtcPacket previous

// One request carries current AND previous SOURCE snapshots.
// A fresh object per source bar prevents historical aliasing.
// Recurrences run every source bar; only final objects are returned.
// This is a live monitoring draft, not a historical screener backtest.
// Latest mode uses the current HTF candle even while the host market is closed.
// Its unoffset lookahead_on values MUST NOT be used as historical trade evidence.
f_atc_pair() =>
    [json, endTime, bull, bear, neutral, known, primary, stop, tp1, tp2, tp3, shortPrimary, shortStop, shortTp1, shortTp2, shortTp3] = f_atc_state()
    AtcPacket packet = na
    bool recentSource = last_bar_index - bar_index <= 2
    if recentSource
        packet := AtcPacket.new(json, endTime, time, syminfo.tickerid, syminfo.prefix, syminfo.ticker, syminfo.currency, close, volume, bull, bear, neutral, known, syminfo.type == "stock" or (syminfo.prefix == "BIST" and syminfo.ticker == "ALTIN"), syminfo.type, primary, stop, tp1, tp2, tp3, shortPrimary, shortStop, shortTp1, shortTp2, shortTp3)
    AtcPair result = recentSource ? AtcPair.new(packet, packet[1]) : na
    result

f_atc_stock_name(string tickerId) =>
    str.replace(str.replace(str.replace(tickerId, "BIST_DLY:", ""), "BISTMIXED:", ""), "BIST:", "")

// Select actual source bars, never substitute the host chart's timestamps.
// Independent feeds can temporarily lag the host. In latest mode a closed
// auction bar remains the latest real candle until the next matched trade.
f_atc_selectable(AtcPacket packet, int hostEnd, int observationTime) =>
    not na(packet) and not na(packet.openTime) and not na(packet.endTime) and packet.openTime < packet.endTime and packet.openTime <= observationTime and (not onlyClosedBar or packet.endTime <= hostEnd)

f_atc_select(AtcPair pair, int hostEnd, int observationTime) =>
    AtcPacket selected = na
    if not na(pair)
        if f_atc_selectable(pair.current, hostEnd, observationTime)
            selected := pair.current
        else if f_atc_selectable(pair.previous, hostEnd, observationTime)
            selected := pair.previous
    selected

f_atc_valid(AtcPacket packet) =>
    not na(packet) and packet.known > 0 and packet.json != "" and not na(packet.endTime)

// Monitoring eligibility and last-trade freshness are different facts.
// Preserve exact instrument eligibility; reject another symbol, prior session,
// impossible/future hourly intervals and unknown price/volume. A closed candle
// is transported with its true bar_confirmed=true and original open/close.
f_atc_source_ready(AtcPacket packet, string requestedSymbol, int hostEnd, int closedEnd, int observationTime) =>
    bool result = false
    if f_atc_valid(packet)
        bool sourceBist = packet.sourcePrefix == "BIST" or packet.sourcePrefix == "BISTMIXED" or packet.sourcePrefix == "BIST_DLY"
        bool sameSymbol = packet.sourceTicker == f_atc_stock_name(requestedSymbol)
        bool sameSessionDay = str.format_time(packet.openTime, "yyyy-MM-dd", "Europe/Istanbul") == str.format_time(observationTime, "yyyy-MM-dd", "Europe/Istanbul")
        bool actualHour = not na(packet.openTime) and not na(packet.endTime) and packet.openTime < packet.endTime and packet.endTime - packet.openTime <= 3600000 and packet.openTime <= observationTime and packet.endTime <= hostEnd
        bool sourceTimeReady = actualHour and (onlyClosedBar ? packet.endTime == closedEnd : sameSessionDay)
        result := packet.stock and sourceBist and sameSymbol and packet.currency == "TRY" and not na(packet.price) and packet.price > 0 and not na(packet.volume) and packet.volume >= 0 and sourceTimeReady
    result

f_atc_long(AtcPacket packet) =>
    f_atc_valid(packet) and f_atc_count(packet.bull) >= 2

f_atc_short(AtcPacket packet) =>
    f_atc_valid(packet) and f_atc_count(packet.bear) >= 2

f_atc_summary(AtcPacket packet) =>
    string result = "Veri yok"
    if f_atc_valid(packet)
        result := "↑" + str.tostring(f_atc_count(packet.bull)) + " ↓" + str.tostring(f_atc_count(packet.bear)) + " ·" + str.tostring(f_atc_count(packet.neutral)) + " / " + str.tostring(f_atc_count(packet.known)) + "\n" + (packet.endTime > timenow ? "ACIK " : "KAPALI ") + str.format_time(packet.openTime, "dd.MM HH:mm", "Europe/Istanbul")
    result

f_atc_color(AtcPacket packet) =>
    bool up = f_atc_long(packet)
    bool down = f_atc_short(packet)
    up and down ? color.rgb(170,110,20) : up ? color.rgb(15,110,74) : down ? color.rgb(155,40,50) : color.rgb(38,48,65)

// A requested packet can be cached across source ticks. Maturity is based
// on that packet's real scheduled close and this frozen observation clock.
// Numeric states, prices, volume, plans and source timestamps are unchanged.
f_atc_transport_frame(AtcPacket packet, int observationTime) =>
    string confirmed = packet.endTime <= observationTime ? "true" : "false"
    string result = str.replace(packet.json, '"bar_confirmed":true', '"bar_confirmed":' + confirmed)
    result := str.replace(result, '"bar_confirmed":false', '"bar_confirmed":' + confirmed)
    result

f_atc_snapshot(AtcPacket h1, AtcPacket h4, AtcPacket daily, AtcPacket weekly, string observed, string observationId, int observationTime) =>
    string frames = f_atc_transport_frame(h1, observationTime)
    if f_atc_valid(h4)
        frames += "," + f_atc_transport_frame(h4, observationTime)
    if f_atc_valid(daily)
        frames += "," + f_atc_transport_frame(daily, observationTime)
    if f_atc_valid(weekly)
        frames += "," + f_atc_transport_frame(weekly, observationTime)
    '{"schema":2,"candle_mode":"' + (onlyClosedBar ? "closed" : "latest") + '","signal_id":"' + observationId + '","symbol":"BIST:' + h1.sourceTicker + '","source_feed":"' + h1.sourceId + '","observed_at":"' + observed + '","price":' + str.tostring(h1.price, "#.########") + ',"volume":' + str.tostring(h1.volume, "#.########") + ',"calculation_status":"draft_unverified","frames":[' + frames + ']}'

// Human notifications: primitive varip arrays survive realtime rollback.
var array<string> humanRuleNames = array.from("MACD kesişim", "SMI/MACD momentum", "SMI hacim onayı", "EMA trend/hacim", "RSI/MACD hacim", "SMA/MACD hacim", "SMI/MACD Full", "SMI/MACD erken", "RSI momentum", "Hacim patlaması", "Sıkışma/hacim", "Uç RSI", "Başarısız kırılım", "Karar bölgesi", "Trend devamı", "Tükenme", "Karar Paneli", "MA yakınlık")
varip array<int> humanBars = array.new_int(40, na)
varip array<bool> humanInitialized = array.new_bool(40, false)
varip array<bool> humanActive = array.new_bool(80, false)
varip array<bool> humanSeen = array.new_bool(80, false)
varip array<int> humanHighCount = array.new_int(80, 0)
varip array<bool> humanPending = array.new_bool(80, false)
varip array<bool> humanPendingStrength = array.new_bool(80, false)
varip array<string> humanPendingText = array.new_string(80, "")
varip array<int> humanPendingCount = array.new_int(80, 0)
varip array<int> humanPendingAt = array.new_int(80, na)
varip array<int> humanAlertTimes = array.new_int()
varip bool humanStarted = false

f_human_number(float value) =>
    str.replace(str.tostring(value, "#.####"), ".", ",")

f_human_names(int mask) =>
    string ruleLabelText = ""
    int shown = 0
    int total = f_atc_count(mask)
    for id = 1 to 18
        if f_atc_bit(mask, id) and shown < humanMaxRuleNames
            ruleLabelText += (shown > 0 ? " + " : "") + "#" + str.tostring(id) + " " + array.get(humanRuleNames, id - 1)
            shown += 1
    ruleLabelText + (total > shown ? " +" + str.tostring(total - shown) + " tarama" : "")

f_human_line(AtcPacket packet, string frameText, string stockText, bool up, bool stronger, int eventAt, int observationTime) =>
    int mask = up ? packet.bull : packet.bear
    string direction = up ? "AL ADAYI" : "SHORT / DÜŞÜŞ ADAYI"
    string eventText = stronger ? " · GÜÇLENDİ" : ""
    string clockText = str.format_time(observationTime, "HH:mm:ss", "Europe/Istanbul")
    int primary = up ? packet.primary : packet.shortPrimary
    float s = up ? packet.planStop : packet.shortStop
    float t1 = up ? packet.planTp1 : packet.shortTp1
    float t2 = up ? packet.planTp2 : packet.shortTp2
    float t3 = up ? packet.planTp3 : packet.shortTp3
    bool coherent = primary > 0 and f_atc_bit(mask, primary) and s > 0 and t1 > 0 and t2 > 0 and t3 > 0 and (up ? s < packet.price and packet.price < t1 and t1 < t2 and t2 < t3 : t3 < t2 and t2 < t1 and t1 < packet.price and packet.price < s)
    string levels = coherent ? "Stop " + f_human_number(s) + " | TP1 " + f_human_number(t1) + " | TP2 " + f_human_number(t2) + " | TP3 " + f_human_number(t3) + " · Plan #" + str.tostring(primary) : "Stop/TP: Plan yok"
    string maturity = packet.endTime <= observationTime ? "Kapalı mum " : "Açık mum "
    string sourceTime = str.format_time(packet.openTime, "dd.MM HH:mm", "Europe/Istanbul")
    string waitText = observationTime - eventAt >= 1000 ? " · Sıra " + str.tostring(int((observationTime - eventAt) / 1000)) + " sn" : ""
    stockText + " · " + frameText + " · " + direction + eventText + " · " + clockText + waitText + "\nFiyat " + f_human_number(packet.price) + " | " + levels + "\n" + f_human_names(mask) + " · " + maturity + sourceTime

f_human_clear(int slot) =>
    array.set(humanPending, slot, false)
    array.set(humanPendingStrength, slot, false)
    array.set(humanPendingText, slot, "")
    array.set(humanPendingCount, slot, 0)
    array.set(humanPendingAt, slot, na)

f_human_observe(AtcPacket packet, int frameIndex, string frameText, string stockText, bool sourceReady, bool realtime, bool initialObservation, int observationTime) =>
    bool valid = sourceReady and f_atc_valid(packet) and packet.sourceTicker == stockText and packet.currency == "TRY" and not na(packet.openTime) and packet.openTime <= observationTime and not na(packet.price) and packet.price > 0
    int firstSlot = frameIndex * 2
    // Even slot = LONG; odd slot = bearish. Never retain a bearish queue item.
    f_human_clear(firstSlot + 1)
    if not valid
        f_human_clear(firstSlot)
        f_human_clear(firstSlot + 1)
    else
        bool initialized = array.get(humanInitialized, frameIndex)
        int priorBar = array.get(humanBars, frameIndex)
        bool newBar = na(priorBar) or priorBar != packet.openTime
        if newBar
            array.set(humanBars, frameIndex, packet.openTime)
            for side = 0 to 1
                int slot = firstSlot + side
                int count = f_atc_count(side == 0 ? packet.bull : packet.bear)
                array.set(humanSeen, slot, false)
                array.set(humanHighCount, slot, count)
                f_human_clear(slot)
        for side = 0 to 1
            int slot = firstSlot + side
            bool up = side == 0
            if not up
                f_human_clear(slot)
            int mask = up ? packet.bull : packet.bear
            int count = f_atc_count(mask)
            bool active = count >= 2
            bool wasActive = array.get(humanActive, slot)
            bool seen = array.get(humanSeen, slot)
            int priorHigh = array.get(humanHighCount, slot)
            bool stronger = humanStrengthening and initialized and not newBar and active and wasActive and count > priorHigh
            bool becameActive = active and not wasActive
            bool initialActive = humanInitial and initialObservation and active
            // Warm baseline is silent by default. Persistent state across
            // source bars is not called a new crossover merely by a new clock.
            bool notify = up and realtime and (initialized or humanInitial) and active and (not seen or stronger) and (becameActive or stronger or initialActive)
            if notify and not array.get(humanPending, slot)
                array.set(humanPending, slot, true)
                array.set(humanPendingStrength, slot, stronger)
                array.set(humanPendingAt, slot, observationTime)
            bool queued = array.get(humanPending, slot)
            bool queuedStrength = array.get(humanPendingStrength, slot)
            // Never flush an inactive or no-longer-strengthened queued finding.
            if queued and (not active or (queuedStrength and count <= priorHigh))
                f_human_clear(slot)
            else if queued
                int eventAt = array.get(humanPendingAt, slot)
                array.set(humanPendingText, slot, f_human_line(packet, frameText, stockText, up, queuedStrength, eventAt, observationTime))
                array.set(humanPendingCount, slot, count)
            array.set(humanActive, slot, active)
            if not initialized
                array.set(humanHighCount, slot, count)
        array.set(humanInitialized, frameIndex, true)

selectedGroup = input.int(1, "Taranacak grup (1-64)", minval=1, maxval=64, group="Hisse Grubu")
var array<string> atcUniverse = str.split("BIST:A1CAP|BIST:A1YEN|BIST:AAGYO|BIST:ACSEL|BIST:ADEL|BIST:ADESE|BIST:ADGYO|BIST:AEFES|BIST:AFYON|BIST:AGESA|BIST:AGHOL|BIST:AGROT|BIST:AGYO|BIST:AHGAZ|BIST:AHSGY|BIST:AKBNK|BIST:AKCNS|BIST:AKENR|BIST:AKFGY|BIST:AKFIS|BIST:AKFYE|BIST:AKGRT|BIST:AKHAN|BIST:AKMGY|BIST:AKSA|BIST:AKSEN|BIST:AKSGY|BIST:AKSUE|BIST:AKYHO|BIST:ALARK|BIST:ALBRK|BIST:ALBTN|BIST:ALCAR|BIST:ALCTL|BIST:ALFAS|BIST:ALGYO|BIST:ALKA|BIST:ALKIM|BIST:ALKLC|BIST:ALTNY|BIST:ALVES|BIST:ANELE|BIST:ANGEN|BIST:ANHYT|BIST:ANSGR|BIST:ARASE|BIST:ARCLK|BIST:ARDYZ|BIST:ARENA|BIST:ARFYE|BIST:ARMGD|BIST:ARSAN|BIST:ARTMS|BIST:ARZUM|BIST:ASELS|BIST:ASGYO|BIST:ASTOR|BIST:ASUZU|BIST:ATAGY|BIST:ATAKP|BIST:ATATP|BIST:ATATR|BIST:ATEKS|BIST:ATLAS|BIST:ATSYH|BIST:AVGYO|BIST:AVHOL|BIST:AVOD|BIST:AVPGY|BIST:AVTUR|BIST:AYCES|BIST:AYDEM|BIST:AYEN|BIST:AYES|BIST:AYGAZ|BIST:AZTEK|BIST:BAGFS|BIST:BAHKM|BIST:BAKAB|BIST:BALAT|BIST:BALSU|BIST:BANVT|BIST:BARMA|BIST:BASCM|BIST:BASGZ|BIST:BAYRK|BIST:BEGYO|BIST:BERA|BIST:BESLR|BIST:BESTE|BIST:BETAE|BIST:BEYAZ|BIST:BFREN|BIST:BIENY|BIST:BIGCH|BIST:BIGEN|BIST:BIGTK|BIST:BIMAS|BIST:BINBN|BIST:BINHO|BIST:BIOEN|BIST:BIZIM|BIST:BJKAS|BIST:BKRGY|BIST:BLCYT|BIST:BLUME|BIST:BMSCH|BIST:BMSTL|BIST:BNTAS|BIST:BOBET|BIST:BORLS|BIST:BORSK|BIST:BOSSA|BIST:BRISA|BIST:BRKO|BIST:BRKSN|BIST:BRKVY|BIST:BRLSM|BIST:BRMEN|BIST:BRSAN|BIST:BRYAT|BIST:BSOKE|BIST:BTCIM|BIST:BUCIM|BIST:BULGS|BIST:BURCE|BIST:BURVA|BIST:BVSAN|BIST:BYDNR|BIST:CANTE|BIST:CASA|BIST:CATES|BIST:CCOLA|BIST:CELHA|BIST:CEMAS|BIST:CEMTS|BIST:CEMZY|BIST:CEOEM|BIST:CGCAM|BIST:CIMSA|BIST:CITAS|BIST:CLEBI|BIST:CMBTN|BIST:CMENT|BIST:CONSE|BIST:COSMO|BIST:CRDFA|BIST:CRFSA|BIST:CUSAN|BIST:CVKMD|BIST:CWENE|BIST:DAGI|BIST:DAPGM|BIST:DARDL|BIST:DCTTR|BIST:DENGE|BIST:DERHL|BIST:DERIM|BIST:DESA|BIST:DESPC|BIST:DEVA|BIST:DGATE|BIST:DGGYO|BIST:DGNMO|BIST:DIRIT|BIST:DITAS|BIST:DMRGD|BIST:DMSAS|BIST:DNISI|BIST:DOAS|BIST:DOCO|BIST:DOFER|BIST:DOFRB|BIST:DOGUB|BIST:DOHOL|BIST:DOKTA|BIST:DSTKF|BIST:DUNYH|BIST:DURDO|BIST:DURKN|BIST:DYOBY|BIST:DZGYO|BIST:EBEBK|BIST:ECILC|BIST:ECOGR|BIST:ECZYT|BIST:EDATA|BIST:EDIP|BIST:EFOR|BIST:EGEEN|BIST:EGEGY|BIST:EGEPO|BIST:EGGUB|BIST:EGPRO|BIST:EGSER|BIST:EKDMR|BIST:EKGYO|BIST:EKIM|BIST:EKIZ|BIST:EKOS|BIST:EKSUN|BIST:ELITE|BIST:EMKEL|BIST:EMNIS|BIST:EMPAE|BIST:ENDAE|BIST:ENERY|BIST:ENJSA|BIST:ENKAI|BIST:ENPRA|BIST:ENSRI|BIST:ENTRA|BIST:EPLAS|BIST:ERBOS|BIST:ERCB|BIST:EREGL|BIST:ERSU|BIST:ESCAR|BIST:ESCOM|BIST:ESEN|BIST:ETILR|BIST:ETYAT|BIST:EUHOL|BIST:EUKYO|BIST:EUPWR|BIST:EUREN|BIST:EUYO|BIST:EYGYO|BIST:FADE|BIST:FENER|BIST:FLAP|BIST:FMIZP|BIST:FONET|BIST:FORMT|BIST:FORTE|BIST:FRIGO|BIST:FRMPL|BIST:FROTO|BIST:FZLGY|BIST:GARAN|BIST:GARFA|BIST:GATEG|BIST:GEDIK|BIST:GEDZA|BIST:GENIL|BIST:GENKM|BIST:GENTS|BIST:GEREL|BIST:GESAN|BIST:GIPTA|BIST:GLBMD|BIST:GLCVY|BIST:GLRMK|BIST:GLRYH|BIST:GLYHO|BIST:GMTAS|BIST:GOKNR|BIST:GOLDA|BIST:GOLTS|BIST:GOODY|BIST:GOZDE|BIST:GRNYO|BIST:GRSEL|BIST:GRTHO|BIST:GSDDE|BIST:GSDHO|BIST:GSRAY|BIST:GUBRF|BIST:GUNDG|BIST:GWIND|BIST:GZNMI|BIST:HALKB|BIST:HATEK|BIST:HATSN|BIST:HDFGS|BIST:HEDEF|BIST:HEKTS|BIST:HKTM|BIST:HLGYO|BIST:HOROZ|BIST:HRKET|BIST:HTTBT|BIST:HUBVC|BIST:HUNER|BIST:HURGZ|BIST:ICBCT|BIST:ICUGS|BIST:IDGYO|BIST:IEYHO|BIST:IHAAS|BIST:IHEVA|BIST:IHGZT|BIST:IHLAS|BIST:IHLGM|BIST:IHYAY|BIST:IMASM|BIST:INDES|BIST:INFO|BIST:INGRM|BIST:INTEK|BIST:INTEM|BIST:INTET|BIST:INVEO|BIST:INVES|BIST:ISATR|BIST:ISBIR|BIST:ISBTR|BIST:ISCTR|BIST:ISDMR|BIST:ISFIN|BIST:ISGSY|BIST:ISGYO|BIST:ISKPL|BIST:ISKUR|BIST:ISMEN|BIST:ISSEN|BIST:ISVEA|BIST:ISYAT|BIST:IZENR|BIST:IZFAS|BIST:IZINV|BIST:IZMDC|BIST:JANTS|BIST:KAPLM|BIST:KARCL|BIST:KAREL|BIST:KARSN|BIST:KARTN|BIST:KATMR|BIST:KAYSE|BIST:KBORU|BIST:KCAER|BIST:KCHOL|BIST:KENT|BIST:KERVN|BIST:KFEIN|BIST:KGYO|BIST:KIMMR|BIST:KLGYO|BIST:KLKIM|BIST:KLMSN|BIST:KLNMA|BIST:KLRHO|BIST:KLSER|BIST:KLSYN|BIST:KLYPV|BIST:KMPUR|BIST:KNFRT|BIST:KOCMT|BIST:KONKA|BIST:KONTR|BIST:KONYA|BIST:KOPOL|BIST:KORDS|BIST:KOTON|BIST:KPEKS|BIST:KRDMA|BIST:KRDMB|BIST:KRDMD|BIST:KRGYO|BIST:KRONT|BIST:KRPLS|BIST:KRSTL|BIST:KRTEK|BIST:KRVGD|BIST:KSTUR|BIST:KTLEV|BIST:KTSKR|BIST:KUTPO|BIST:KUVVA|BIST:KUYAS|BIST:KZBGY|BIST:KZGYO|BIST:LIDER|BIST:LIDFA|BIST:LILAK|BIST:LINK|BIST:LKMNH|BIST:LMKDC|BIST:LOGO|BIST:LRSHO|BIST:LUKSK|BIST:LXGYO|BIST:LYDHO|BIST:LYDYE|BIST:MAALT|BIST:MACKO|BIST:MAGEN|BIST:MAKIM|BIST:MAKTK|BIST:MANAS|BIST:MARBL|BIST:MARMR|BIST:MARTI|BIST:MASFN|BIST:MAVI|BIST:MCARD|BIST:MEDTR|BIST:MEGAP|BIST:MEGMT|BIST:MEKAG|BIST:MEPET|BIST:MERCN|BIST:MERIT|BIST:MERKO|BIST:METEN|BIST:METRO|BIST:MEYSU|BIST:MGROS|BIST:MHRGY|BIST:MIATK|BIST:MMCAS|BIST:MNDRS|BIST:MNDTR|BIST:MOBTL|BIST:MOGAN|BIST:MOPAS|BIST:MPARK|BIST:MRGYO|BIST:MRSHL|BIST:MSGYO|BIST:MTRKS|BIST:MTRYO|BIST:MZHLD|BIST:NATEN|BIST:NETAS|BIST:NETCD|BIST:NETGL|BIST:NIBAS|BIST:NTGAZ|BIST:NTHOL|BIST:NUGYO|BIST:NUHCM|BIST:OBAMS|BIST:OBASE|BIST:ODAS|BIST:ODINE|BIST:OFSYM|BIST:ONCSM|BIST:ONRYT|BIST:ORCAY|BIST:ORGE|BIST:ORMA|BIST:ORZAX|BIST:OSMEN|BIST:OSTIM|BIST:OTKAR|BIST:OTTO|BIST:OYAKC|BIST:OYAYO|BIST:OYLUM|BIST:OYYAT|BIST:OZATD|BIST:OZGYO|BIST:OZKGY|BIST:OZRDN|BIST:OZSUB|BIST:OZYSR|BIST:PAGYO|BIST:PAHOL|BIST:PAMEL|BIST:PAPIL|BIST:PARSN|BIST:PASEU|BIST:PATEK|BIST:PCILT|BIST:PEKGY|BIST:PENGD|BIST:PENTA|BIST:PETKM|BIST:PETUN|BIST:PGSUS|BIST:PINSU|BIST:PKART|BIST:PKENT|BIST:PLTUR|BIST:PNLSN|BIST:PNSUT|BIST:POLHO|BIST:POLTK|BIST:PRDGS|BIST:PRKAB|BIST:PRKME|BIST:PRZMA|BIST:PSDTC|BIST:PSGYO|BIST:QNBFK|BIST:QNBTR|BIST:QUAGR|BIST:QUICK|BIST:RALYH|BIST:RAYSG|BIST:REEDR|BIST:RGYAS|BIST:RNPOL|BIST:RODRG|BIST:RTALB|BIST:RUBNS|BIST:RUZYE|BIST:RYGYO|BIST:RYSAS|BIST:SAFKR|BIST:SAHOL|BIST:SAMAT|BIST:SANEL|BIST:SANFM|BIST:SANKO|BIST:SARAE|BIST:SARKY|BIST:SASA|BIST:SAYAS|BIST:SDTTR|BIST:SEGMN|BIST:SEGYO|BIST:SEKFK|BIST:SEKUR|BIST:SELEC|BIST:SELVA|BIST:SERNT|BIST:SEYKM|BIST:SILVR|BIST:SISE|BIST:SKBNK|BIST:SKTAS|BIST:SKYLP|BIST:SKYMD|BIST:SMART|BIST:SMRTG|BIST:SMRVA|BIST:SNGYO|BIST:SNICA|BIST:SNPAM|BIST:SODSN|BIST:SOHOE|BIST:SOKE|BIST:SOKM|BIST:SONME|BIST:SRVGY|BIST:SSAAT|BIST:SUMAS|BIST:SUNTK|BIST:SURGY|BIST:SUWEN|BIST:SVGYO|BIST:TABGD|BIST:TARKM|BIST:TATEN|BIST:TATGD|BIST:TAVHL|BIST:TBORG|BIST:TCELL|BIST:TCKRC|BIST:TDGYO|BIST:TEHOL|BIST:TEKTU|BIST:TERA|BIST:TEZOL|BIST:TGSAS|BIST:THYAO|BIST:TKFEN|BIST:TKNKA|BIST:TKNSA|BIST:TLMAN|BIST:TMPOL|BIST:TMSN|BIST:TNZTP|BIST:TOASO|BIST:TRALT|BIST:TRCAS|BIST:TRENJ|BIST:TRGYO|BIST:TRHOL|BIST:TRILC|BIST:TRMET|BIST:TSGYO|BIST:TSKB|BIST:TSPOR|BIST:TTKOM|BIST:TTRAK|BIST:TUCLK|BIST:TUKAS|BIST:TUPRS|BIST:TUREX|BIST:TURGG|BIST:TURSG|BIST:UCAYM|BIST:UFUK|BIST:ULAS|BIST:ULKER|BIST:ULUFA|BIST:ULUSE|BIST:ULUUN|BIST:UMPAS|BIST:UNLU|BIST:USAK|BIST:USHOL|BIST:VAKBN|BIST:VAKFA|BIST:VAKFN|BIST:VAKKO|BIST:VANGD|BIST:VBTYZ|BIST:VERTU|BIST:VERUS|BIST:VESBE|BIST:VESTL|BIST:VEYAS|BIST:VKFYO|BIST:VKGYO|BIST:VKING|BIST:VRGYO|BIST:VSNMD|BIST:YAPRK|BIST:YATAS|BIST:YAYLA|BIST:YBTAS|BIST:YEOTK|BIST:YESIL|BIST:YGGYO|BIST:YIGIT|BIST:YKBNK|BIST:YKSLN|BIST:YONGA|BIST:YUNSA|BIST:YYAPI|BIST:YYLGD|BIST:ZEDUR|BIST:ZERGY|BIST:ZGYO|BIST:ZOREN|BIST:ZRGYO", "|")
groupId = "BIST631-" + (selectedGroup < 10 ? "0" : "") + str.tostring(selectedGroup)
int groupStart = (selectedGroup - 1) * 10
int groupSize = math.min(10, array.size(atcUniverse) - groupStart)
array<string> symbols = array.new_string()
// Slice only actual members. Group 64 has one ticker and four contexts.
for memberIndex = 0 to groupSize - 1
    array.push(symbols, array.get(atcUniverse, groupStart + memberIndex))
array<string> seen = array.new<string>()
bool configValid = str.match(groupId, "^[A-Za-z0-9_-]{1,16}$") == groupId
string groupSymbols = ""
for i = 0 to groupSize - 1
    string selectedSymbol = array.get(symbols, i)
    bool validSymbol = str.match(selectedSymbol, "^(BIST|BISTMIXED|BIST_DLY):[A-Z][A-Z0-9]{0,11}$") == selectedSymbol
    if not validSymbol or array.includes(seen, f_atc_stock_name(selectedSymbol))
        configValid := false
    array.push(seen, f_atc_stock_name(selectedSymbol))
    groupSymbols += (i > 0 ? "-" : "") + f_atc_stock_name(selectedSymbol)

var table batchTable = table.new(position.top_right, 7, 13, border_width=1, border_color=color.rgb(80,95,115))
if barstate.islast
    table.clear(batchTable, 0, 0, 6, 12)
    table.merge_cells(batchTable, 0, 11, 6, 11)
    table.merge_cells(batchTable, 0, 12, 6, 12)
    array<string> headers = array.from("HISSE", "1 SAAT", "4 SAAT", "GUNLUK", "HAFTALIK", "TUMU", "VERI")
    for column = 0 to 6
        table.cell(batchTable, column, 0, array.get(headers, column), bgcolor=color.rgb(22,53,77), text_color=color.white, text_size=size.small)

bool hourlyClock = timeframe.period == "60" and chart.is_standard and syminfo.currency == "TRY" and (syminfo.prefix == "BIST" or syminfo.prefix == "BISTMIXED" or syminfo.prefix == "BIST_DLY")
// Observe meaningful changes on every realtime host update. No fixed 20s delay.
int emissionTime = timenow
bool humanObserve = hourlyClock and (barstate.isrealtime or barstate.islastconfirmedhistory)
bool humanInitialObservation = barstate.isrealtime and not humanStarted
int accepted = 0
// An unconfirmed host candle cannot attest its future scheduled close.
// Use its open time as the conservative cutoff, including delayed feeds.
int closedCutoff = barstate.isrealtime and not barstate.isconfirmed ? time : time_close
// All contexts are requested on historical bars, never first created in the alert branch.
// Exactly four direct contexts per stock; ten stocks consume forty unique requests.
// Actual request/CPU limits and source-data parity require runtime verification.
for i = 0 to groupSize - 1
    string requestedSymbol = array.get(symbols, i)
    AtcPair h1Pair = request.security(requestedSymbol, "60", f_atc_pair(), gaps=barmerge.gaps_off, lookahead=onlyClosedBar ? barmerge.lookahead_off : barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=atcBars+30)
    AtcPair h4Pair = request.security(requestedSymbol, "240", f_atc_pair(), gaps=barmerge.gaps_off, lookahead=onlyClosedBar ? barmerge.lookahead_off : barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=atcBars+30)
    AtcPair dPair = request.security(requestedSymbol, "D", f_atc_pair(), gaps=barmerge.gaps_off, lookahead=onlyClosedBar ? barmerge.lookahead_off : barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=atcBars+30)
    AtcPair wPair = request.security(requestedSymbol, "W", f_atc_pair(), gaps=barmerge.gaps_off, lookahead=onlyClosedBar ? barmerge.lookahead_off : barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=atcBars+30)
    AtcPacket h1 = f_atc_select(h1Pair, closedCutoff, emissionTime)
    AtcPacket h4 = f_atc_select(h4Pair, closedCutoff, emissionTime)
    AtcPacket daily = f_atc_select(dPair, closedCutoff, emissionTime)
    AtcPacket weekly = f_atc_select(wPair, closedCutoff, emissionTime)
    bool allLong = f_atc_long(h1) and f_atc_long(h4) and f_atc_long(daily) and f_atc_long(weekly)
    bool allShort = f_atc_short(h1) and f_atc_short(h4) and f_atc_short(daily) and f_atc_short(weekly)
    bool sourceReady = f_atc_source_ready(h1, requestedSymbol, time_close, closedCutoff, emissionTime)
    if configValid and humanObserve
        if sourceReady
            accepted += 1
        int frameIndex = i * 4
        string stockText = f_atc_stock_name(requestedSymbol)
        f_human_observe(h1, frameIndex, "1 saat", stockText, sourceReady, barstate.isrealtime, humanInitialObservation, emissionTime)
        f_human_observe(h4, frameIndex + 1, "4 saat", stockText, sourceReady, barstate.isrealtime, humanInitialObservation, emissionTime)
        f_human_observe(daily, frameIndex + 2, "Günlük", stockText, sourceReady, barstate.isrealtime, humanInitialObservation, emissionTime)
        f_human_observe(weekly, frameIndex + 3, "Haftalık", stockText, sourceReady, barstate.isrealtime, humanInitialObservation, emissionTime)
    if barstate.islast
        int row = i + 1
        table.cell(batchTable, 0, row, f_atc_stock_name(requestedSymbol), bgcolor=color.rgb(22,53,77), text_color=color.white, text_size=size.small)
        table.cell(batchTable, 1, row, f_atc_summary(h1), bgcolor=f_atc_color(h1), text_color=color.white, text_size=size.small)
        table.cell(batchTable, 2, row, f_atc_summary(h4), bgcolor=f_atc_color(h4), text_color=color.white, text_size=size.small)
        table.cell(batchTable, 3, row, f_atc_summary(daily), bgcolor=f_atc_color(daily), text_color=color.white, text_size=size.small)
        table.cell(batchTable, 4, row, f_atc_summary(weekly), bgcolor=f_atc_color(weekly), text_color=color.white, text_size=size.small)
        string common = allLong and allShort ? "↑ ve ↓" : allLong ? "↑ KESISIM" : allShort ? "↓ KESISIM" : "—"
        color commonColor = allLong and allShort ? color.rgb(170,110,20) : allLong ? color.rgb(15,110,74) : allShort ? color.rgb(155,40,50) : color.rgb(38,48,65)
        table.cell(batchTable, 5, row, common, bgcolor=commonColor, text_color=color.white, text_size=size.small)
        string sourceText = "Veri yok"
        if not na(h1)
            string sourceBarTime = str.format_time(h1.openTime, "dd.MM HH:mm", "Europe/Istanbul")
            string sourceBarAge = h1.endTime > emissionTime ? "ACIK MUM" : "KAPALI MUM " + str.tostring(math.max(0, int((emissionTime - h1.endTime) / 60000))) + " dk"
            sourceText := h1.sourcePrefix + " · " + h1.sourceType + "\n" + sourceBarTime + " · " + sourceBarAge + "\n" + (na(h1.volume) ? "Hacim yok" : "Hacim var") + (sourceReady ? "" : " · GONDERILMIYOR")
        table.cell(batchTable, 6, row, sourceText, bgcolor=color.rgb(38,48,65), text_color=color.white, text_size=size.small)

// One grouped call per host iteration; <=14 calls in every 180-second window.
while array.size(humanAlertTimes) > 0
    if emissionTime - array.get(humanAlertTimes, 0) > 180000
        array.shift(humanAlertTimes)
    else
        break
if barstate.isrealtime and accepted > 0
    humanStarted := true
if atcEnabled and configValid and hourlyClock and barstate.isrealtime and accepted > 0 and array.size(humanAlertTimes) < 14
    string message = ""
    array<int> emittedSlots = array.new_int()
    for slot = 0 to 79
        // Independent final gate: an odd/bearish slot cannot reach alert().
        if slot % 2 == 0 and array.get(humanPending, slot) and array.size(emittedSlots) < humanMaxEvents
            message += (array.size(emittedSlots) > 0 ? "\n\n" : "") + array.get(humanPendingText, slot)
            array.push(emittedSlots, slot)
    if array.size(emittedSlots) > 0
        alert("ATC AL · " + groupId + " · " + str.tostring(array.size(emittedSlots)) + " aday\n" + message, alert.freq_all)
        array.push(humanAlertTimes, emissionTime)
        for slot in emittedSlots
            array.set(humanSeen, slot, true)
            array.set(humanHighCount, slot, math.max(array.get(humanHighCount, slot), array.get(humanPendingCount, slot)))
            f_human_clear(slot)

int humanQueueCount = 0
for slot = 0 to 79
    humanQueueCount += slot % 2 == 0 and array.get(humanPending, slot) ? 1 : 0

if barstate.islast
    string status = not configValid ? "HATALI / TEKRARLI HISSE YA DA GRUP ADI" : not hourlyClock ? "ALARM ICIN BIST 1 SAAT NORMAL MUM GRAFIGI" : groupId + " · " + str.tostring(groupSize) + " HISSE · " + (onlyClosedBar ? "KAPALI MUM" : "SON MUM") + " · TASLAK"
    table.cell(batchTable, 0, 11, status, bgcolor=color.rgb(22,53,77), text_color=configValid and hourlyClock ? color.white : color.yellow, text_size=size.small)
    table.cell(batchTable, 0, 12, notificationPolicy + "\n" + calibrationCoverage + (calibratedLevelsEnabled ? " · AÇIK" : " · KAPALI") + "\nDiğer eşleşmeler: mevcut referans · Sırada " + str.tostring(humanQueueCount) + " · 14/180sn koruması · hesap eşitliği ayrıca doğrulanır", bgcolor=color.rgb(38,48,65), text_color=color.rgb(255,205,90), text_size=size.small)
