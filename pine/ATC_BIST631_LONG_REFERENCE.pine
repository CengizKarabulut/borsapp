//@version=6
indicator("ATC BIST631 LONG REF-20261023", shorttitle="ATC631L23", overlay=true, max_bars_back=3500)

// Historical CAL18 profiles disabled after adjustment-basis audit; all plans are uncalibrated references.
// Closed-OHLC research cannot recreate intrabar alerts. Fixed stop; no automatic trailing.
// Native formula ports 1-18. Identical-feed Python numerical parity NOT verified.
// Monitoring only. Rule18 runs its historical research in the same source frame.
// A=M-1/macd_cross, B=S-M-1/h8, C=S-M-V-1/i9, D=E-V-1/ema,
// E=R-M-V-1/rsi_macd, F=A-M-V-1/new_scan, G=S-M-V-2/full,
// H=S-M-2/smi early, I=R-V-1/rsi.

onlyClosedBar = input.bool(false, "Sadece kapanmis mumda teyit et", group="Genel")
dailyOnly = input.bool(false, "Yalniz 1G kullan", group="Genel")
showPanel = input.bool(true, "A-I panelini goster", group="Panel")
panelPosOpt = input.string("Sag Ust", "Panel konumu", options=["Sag Ust", "Sag Orta", "Sol Ust", "Sol Orta"], group="Panel")
panelSizeOpt = input.string("Kucuk", "Panel boyutu", options=["Mini", "Kucuk", "Normal"], group="Panel")

panelPosition = panelPosOpt == "Sol Ust" ? position.top_left : panelPosOpt == "Sol Orta" ? position.middle_left : panelPosOpt == "Sag Orta" ? position.middle_right : position.top_right
panelTextSize = panelSizeOpt == "Mini" ? size.tiny : panelSizeOpt == "Normal" ? size.normal : size.small
closedGate = not onlyClosedBar or barstate.isconfirmed
timeframeOk = not dailyOnly or timeframe.isdaily

f_ewm_alpha(float source, int length) =>
    float alpha = 1.0 / length
    float value = na
    value := na(source) ? value[1] : na(value[1]) ? source : alpha * source + (1.0 - alpha) * value[1]
    value

// indicators.calc_rsi parity.
f_rsi(float source, int length) =>
    float change = ta.change(source)
    float gain = na(change) ? na : math.max(change, 0.0)
    float loss = na(change) ? na : math.max(-change, 0.0)
    float avgGain = f_ewm_alpha(gain, length)
    float avgLoss = f_ewm_alpha(loss, length)
    avgLoss == 0 ? na : 100.0 - 100.0 / (1.0 + avgGain / avgLoss)

// filters.calc_rsi parity (ilk change=0 seed).
f_filter_rsi(float source, int length) =>
    float change = ta.change(source)
    float gain = na(change) ? 0.0 : change > 0 ? change : 0.0
    float loss = na(change) ? 0.0 : change < 0 ? -change : 0.0
    float avgGain = f_ewm_alpha(gain, length)
    float avgLoss = f_ewm_alpha(loss, length)
    avgLoss == 0 ? na : 100.0 - 100.0 / (1.0 + avgGain / avgLoss)

f_double_ema(float source, int length) =>
    ta.ema(ta.ema(source, length), length)

f_tf_text() =>
    string tf = timeframe.period
    tf := tf == "15" ? "15 DK" : tf == "30" ? "30 DK" : tf == "45" ? "45 DK" : tf == "60" ? "1 SA" : tf == "120" ? "2 SA" : tf == "240" ? "4 SA" : tf == "D" ? "1G" : tf == "W" ? "1HFT" : tf == "M" ? "1AY" : tf
    tf

// -----------------------------------------------------------------------------
// Ortak seriler - Python indicators.py / filters.py ile ayni parametreler.
// -----------------------------------------------------------------------------
sma5 = ta.sma(close, 5)
sma8 = ta.sma(close, 8)
sma21 = ta.sma(close, 21)
sma50 = ta.sma(close, 50)
sma55 = ta.sma(close, 55)
sma200 = ta.sma(close, 200)

ema5 = ta.ema(close, 5)
ema8 = ta.ema(close, 8)
ema13 = ta.ema(close, 13)
ema21 = ta.ema(close, 21)
ema55 = ta.ema(close, 55)
ema200 = ta.ema(close, 200)

[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
macdCrossOrRise = (macdLine[1] <= macdSignal[1] and macdLine > macdSignal) or (macdLine > macdSignal and macdLine > macdLine[1])

hh10 = ta.highest(high, 10)
ll10 = ta.lowest(low, 10)
width10 = hh10 - ll10
relative10 = close - (hh10 + ll10) / 2.0
smi = width10 != 0 ? 200.0 * f_double_ema(relative10, 3) / f_double_ema(width10, 3) : 0.0
smiRef = ta.ema(smi, 3)
smiCrossOrRise = (smi[1] <= smiRef[1] and smi > smiRef) or (smi > smiRef and smi > smi[1])

rsi7 = f_rsi(close, 7)
rsi14 = f_rsi(close, 14)
filterRsi7 = f_filter_rsi(close, 7)
filterRsi14 = f_filter_rsi(close, 14)

trRaw = ta.tr(true)
atrEwm14 = f_ewm_alpha(trRaw, 14)
atr14 = bar_index >= 13 ? atrEwm14 : na

vol10 = ta.sma(volume, 10)
vol20 = ta.sma(volume, 20)
volRatio20 = vol20 > 0 ? volume / vol20 : 0.0

// Intraday production tavan filtresi: mevcut fiyat / onceki GUNLUK kapanis.
// [1] + lookahead_on yalniz tamamlanmis onceki 1G barini tum gun boyunca tasir.
// Unused legacy daily-close request removed in this isolated prototype.

// Kaufman Efficiency Ratio.
erDirection = math.abs(close - close[10])
erNoise = ta.sma(math.abs(ta.change(close)), 10) * 10.0
er = erNoise > 0 ? erDirection / erNoise : na
trendRegime = er >= 0.30
softTrendRegime = er >= 0.22
reversalRegime = er <= 0.35

// Directional volume + CMF20. Zero-range bar varsa Python rolling CMF NaN olur;
// validCount kontrolu ayni pencereyi reddeder.
barRange = high - low
mfMultiplier = barRange != 0 ? ((close - low) - (high - close)) / barRange : na
mfVolume = mfMultiplier * volume
mfAvg20 = ta.sma(mfVolume, 20)
volAvg20 = ta.sma(volume, 20)
validCmf = ta.sma(barRange != 0 ? 1.0 : 0.0, 20) >= 0.999999
cmf20 = validCmf and volAvg20 != 0 ? mfAvg20 / volAvg20 : na
directionalVolume = volume > vol20 * 1.5 and close > open and cmf20 > 0

above50 = close > sma50
above200 = close > sma200
priorLow5 = ta.lowest(low[1], 5)
reversalStructure = close > ema8 and close > open and close > close[1] and low >= priorLow5
emaExtensionOk = (close - ema21 <= atr14 * 2.5) and (na(filterRsi14) or filterRsi14 <= 75)
rsiHeatOk = na(filterRsi7) or filterRsi7 <= 85

// -----------------------------------------------------------------------------
// A-I sinyal durumlari.
// -----------------------------------------------------------------------------
smCore = smiCrossOrRise and smi < 0 and macdHist < 0 and macdHist > macdHist[1]
smFullRaw = smCore and above200 and volume > vol20 * 1.5
smEarlyRaw = smCore and not smFullRaw
sigH = timeframeOk and smEarlyRaw and reversalRegime and reversalStructure and directionalVolume
sigG = timeframeOk and smFullRaw and directionalVolume

rsi7CrossOrRise = (rsi7[1] <= 50 and rsi7 > 50) or (rsi7 > 50 and rsi7 > rsi7[1])
rsiRaw = rsi7 > 60 and rsi7CrossOrRise and volume > vol10 * 1.5
sigI = timeframeOk and rsiRaw and above50 and trendRegime and directionalVolume and rsiHeatOk

newRaw = volume > vol20 * 1.5 and close > sma5 and close > sma8 and close > sma21 and close > sma50 and close > sma55 and close > sma200 and macdLine > 0 and macdCrossOrRise
sigF = timeframeOk and newRaw

rsi14Up = (rsi14[1] <= 50 and rsi14 > 50) or (rsi14 > 50 and rsi14 > rsi14[1])
rmvRaw = rsi14Up and rsi14 < 70 and macdCrossOrRise and volume > vol20 * 1.5
sigE = timeframeOk and rmvRaw and above200 and trendRegime and directionalVolume

ev4 = (ema8[1] <= ema13[1] and ema8 > ema13) or (ema8 > ema13 and ema8 > ema8[1])
ev5 = (ema5[1] <= ema8[1] and ema5 > ema8) or (ema5 > ema8 and ema5 > ema5[1])
ev6 = (ema5[1] <= ema13[1] and ema5 > ema13) or (ema5 > ema13 and ema5 > ema5[1])
emaRaw = close > ema200 and close > ema55 and close > ema21 and ev4 and ev5 and ev6 and volume > vol20 * 1.5
sigD = timeframeOk and emaRaw and emaExtensionOk

macdRaw = rsi14 > 30 and macdCrossOrRise and macdLine > 0
sigA = timeframeOk and macdRaw and above50 and trendRegime and directionalVolume

h8Raw = smiCrossOrRise and smi > 0 and macdHist > 0 and macdHist > macdHist[1]
sigB = timeframeOk and h8Raw and above50 and trendRegime and directionalVolume

i9Raw = h8Raw and above200 and volume > vol20 * 1.5
sigC = timeframeOk and i9Raw and softTrendRegime and directionalVolume

freshA = sigA and not sigA[1]
freshB = sigB and not sigB[1]
freshC = sigC and not sigC[1]
freshD = sigD and not sigD[1]
freshE = sigE and not sigE[1]
freshF = sigF and not sigF[1]
freshG = sigG and not sigG[1]
freshH = sigH and not sigH[1]
freshI = sigI and not sigI[1]

// -----------------------------------------------------------------------------
// Scanner ile ayni gorunen stop/TP baslangic planlari.
// -----------------------------------------------------------------------------
f_plan(float swingLow, float emaValue, int mode, float buffer, float minRiskAtr, float maxRiskAtr, float tp1R, float tp2R, float tp3R) =>
    float entry = close
    float swingStop = swingLow - atr14 * buffer
    float signalStop = low - atr14 * buffer
    float emaStop = emaValue - atr14 * buffer
    float fallback = entry - atr14 * minRiskAtr
    float raw = fallback
    if mode == 1
        raw := swingStop
    else if mode == 2
        float best = na
        if swingStop < entry
            best := swingStop
        if signalStop < entry
            best := na(best) ? signalStop : math.min(best, signalStop)
        if emaStop < entry
            best := na(best) ? emaStop : math.min(best, emaStop)
        raw := na(best) ? fallback : best
    else if mode == 3
        float best = na
        if swingStop < entry
            best := swingStop
        if signalStop < entry
            best := na(best) ? signalStop : math.max(best, signalStop)
        if emaStop < entry
            best := na(best) ? emaStop : math.max(best, emaStop)
        raw := na(best) ? fallback : best
    float risk = math.max(entry - raw, 0.0)
    float minRisk = atr14 * minRiskAtr
    float maxRisk = atr14 * maxRiskAtr
    if risk < minRisk
        risk := minRisk
        raw := entry - risk
    else if risk > maxRisk
        risk := maxRisk
        raw := entry - risk
    [raw, entry + risk * tp1R, entry + risk * tp2R, entry + risk * tp3R]

swing4 = ta.lowest(low, 4)
swing6 = ta.lowest(low, 6)
swing7 = ta.lowest(low, 7)
swing8 = ta.lowest(low, 8)

[aStop, aTp1, aTp2, aTp3] = f_plan(swing7, ema21, 3, 0.20, 0.75, 2.35, 1.0, 1.8, 2.8)
[bStop, bTp1, bTp2, bTp3] = f_plan(swing6, ema13, 1, 0.20, 0.70, 2.20, 0.8, 1.5, 2.4)
[cStop, cTp1, cTp2, cTp3] = f_plan(swing7, ema21, 2, 0.20, 0.75, 2.40, 0.8, 1.5, 2.4)
[dStop, dTp1, dTp2, dTp3] = f_plan(swing8, ema21, 3, 0.20, 0.80, 2.50, 1.0, 2.0, 3.2)
[eStop, eTp1, eTp2, eTp3] = f_plan(swing6, ema13, 1, 0.20, 0.70, 2.20, 0.8, 1.5, 2.4)
[fStop, fTp1, fTp2, fTp3] = f_plan(swing8, ema21, 1, 0.20, 0.80, 2.60, 0.8, 1.5, 2.4)
[gStop, gTp1, gTp2, gTp3] = f_plan(swing7, ema21, 1, 0.25, 0.80, 2.50, 0.8, 1.5, 2.4)
[hStop, hTp1, hTp2, hTp3] = f_plan(swing6, ema21, 1, 0.25, 0.75, 2.25, 0.8, 1.5, 2.4)
[iStop, iTp1, iTp2, iTp3] = f_plan(swing4, ema21, 2, 0.15, 0.65, 1.90, 0.8, 1.5, 2.4)


// Pine Script v6 fragment; insert after indicator(). No external I/O, UI or orders.
// Sources: config/{manual-scanner-names.json,scanners.toml};
// src/market_intelligence/features/{volume,technical,volatility,momentum}.py;
// src/market_intelligence/scanning/technical/{volume_spike,market_screens}.py;
// src/market_intelligence/scanning/trade_plan.py (structural-atr-v1).
// Full bounded-frame recalculation preserves the Python recursive seeds.
// Native default history=600, supported setting60..3000 (native/engine.py).
// TradingView compilation, performance and feed parity have NOT been verified.

f_r1016_failed(array<float> lows, array<float> highs, array<float> closes, float level, bool down) =>
    bool pierced = false
    int n = array.size(closes)
    if not na(level)
        for i = math.max(0, n - 5) to n - 1
            pierced := pierced or (down ? array.get(lows, i) < level : array.get(highs, i) > level)
    not na(level) and pierced and (down ? array.get(closes, n - 1) > level : array.get(closes, n - 1) < level)

// Equal volume share over occupied bins;70% value area;lowest tied POC;
// upper-side preference when the two expansion-bin volumes are equal.
f_r1016_profile(array<float> lows, array<float> highs, array<float> volumes) =>
    int n = array.size(lows)
    int firstBar = math.max(0, n - 100)
    float lo = array.get(lows, firstBar)
    float hi = array.get(highs, firstBar)
    for i = firstBar to n - 1
        lo := math.min(lo, array.get(lows, i))
        hi := math.max(hi, array.get(highs, i))
    float poc = na
    float val = na
    float vah = na
    if hi > lo
        float width = (hi - lo) / 48.0
        array<float> bins = array.new<float>(48, 0.0)
        for i = firstBar to n - 1
            int firstBin = math.max(math.min(int((array.get(lows, i) - lo) / width), 47), 0)
            int lastBin = math.max(math.min(int(math.ceil((array.get(highs, i) - lo) / width)) - 1, 47), firstBin)
            float share = array.get(volumes, i) / (lastBin - firstBin + 1)
            for j = firstBin to lastBin
                array.set(bins, j, array.get(bins, j) + share)
        float total = array.sum(bins)
        if total > 0
            int pocIndex = 0
            float biggest = array.get(bins, 0)
            for j = 1 to 47
                if array.get(bins, j) > biggest
                    biggest := array.get(bins, j)
                    pocIndex := j
            int selectedLow = pocIndex
            int selectedHigh = pocIndex
            int lower = pocIndex - 1
            int upper = pocIndex + 1
            float cumulative = array.get(bins, pocIndex)
            while cumulative < total * 0.70 and (lower >= 0 or upper < 48)
                float lowerVolume = lower >= 0 ? array.get(bins, lower) : -1.0
                float upperVolume = upper < 48 ? array.get(bins, upper) : -1.0
                int chosen = upperVolume >= lowerVolume ? upper : lower
                cumulative += array.get(bins, chosen)
                selectedLow := math.min(selectedLow, chosen)
                selectedHigh := math.max(selectedHigh, chosen)
                if chosen == upper
                    upper += 1
                else
                    lower -= 1
            poc := lo + (pocIndex + 0.5) * width
            val := lo + selectedLow * width
            vah := lo + (selectedHigh + 1) * width
    [poc, val, vah]

// Strict RSI pivots5+5;consecutive same-side pairs;spacing5..60;confirmation
// age0..5;regular OR hidden;score>=3. CURRENT snapshot ATR scores all pairs.
f_r1016_divergences(array<float> oscillator, array<float> lows, array<float> highs, float atr) =>
    int n = array.size(oscillator)
    int count = 0
    if n >= 11
        for side = 0 to 1
            bool bullish = side == 0
            int previousIndex = na
            float previousOsc = na
            float previousPrice = na
            for i = 5 to n - 6
                float center = array.get(oscillator, i)
                bool pivot = not na(center)
                for j = i - 5 to i + 5
                    float neighbour = array.get(oscillator, j)
                    if na(neighbour) or (j != i and (bullish ? center >= neighbour : center <= neighbour))
                        pivot := false
                if pivot
                    float price = bullish ? array.get(lows, i) : array.get(highs, i)
                    if not na(previousIndex)
                        int distance = i - previousIndex
                        int age = n - 1 - (i + 5)
                        if distance >= 5 and distance <= 60 and age >= 0 and age <= 5
                            bool regular = bullish ? center > previousOsc and price < previousPrice : center < previousOsc and price > previousPrice
                            bool hidden = bullish ? center < previousOsc and price > previousPrice : center > previousOsc and price < previousPrice
                            if regular or hidden
                                int points = 1 + (age <= 2 ? 1 : 0)
                                points += atr > 0 and math.abs(price - previousPrice) / atr >= 0.75 ? 1 : 0
                                points += math.abs(center - previousOsc) >= 5 ? 1 : 0
                                count += points >= 3 ? 1 : 0
                    previousIndex := i
                    previousOsc := center
                    previousPrice := price
    count

// Cluster anchor=FIRST level;width<=0.25ATR;>=2 source families;
// arithmetic cluster mean must be within0.75ATR of the latest close.
f_r1016_confluence(array<float> levels, array<int> families, float price, float atr) =>
    bool near = false
    int n = array.size(levels)
    if n > 0 and atr > 0
        array<int> indices = array.sort_indices(levels, order.ascending)
        array<bool> seen = array.new<bool>(4, false)
        float anchor = na
        float total = 0.0
        int levelCount = 0
        int familyCount = 0
        for k = 0 to n - 1
            int idx = array.get(indices, k)
            float value = array.get(levels, idx)
            int family = array.get(families, idx)
            if levelCount > 0 and value - anchor > atr * 0.25
                near := near or (familyCount >= 2 and math.abs(total / levelCount - price) / atr <= 0.75)
                array.fill(seen, false)
                total := 0.0
                levelCount := 0
                familyCount := 0
                anchor := na
            if levelCount == 0
                anchor := value
            total += value
            levelCount += 1
            if not array.get(seen, family)
                array.set(seen, family, true)
                familyCount += 1
        near := near or (familyCount >= 2 and math.abs(total / levelCount - price) / atr <= 0.75)
    near

// flags[0..6]=>scanners10..16, WITHOUT candle-close gate;
// dirs[0..6]=>1bullish/-1bearish/0neutral (meaningful only if flags[i]);
// known[0..6]=>features available;distinguish UNKNOWN from NO_MATCH;
// metrics=>[rvol,turnover,BB_rank,RSI,ADX,technicalATR,squeezeBars,setup,
//           structureTone,trendTone,strongDivergences,nearConfluence,
//           POC,VAL,VAH,swingHigh,swingLow,planATR];
// plans=>[longStop,longTP1,longTP2,longTP3,shortStop,shortTP1,shortTP2,shortTP3].
// setup0transition/1failedDown/2failedUp/3decision/4trend/5exhaustion;
// tones1positive/-1negative/0warning;structure2=neutral/not enough pivots.
f_r1016_snapshot(int requestedBars) =>
    int n = math.min(math.max(requestedBars, 1), bar_index + 1)
    array<bool> flags = array.new<bool>(7, false)
    array<int> dirs = array.new<int>(7, 0)
    array<bool> known = array.new<bool>(7, false)
    array<float> metrics = array.new<float>(18, na)
    array<float> plans = array.new<float>(8, na)
    array<float> closes = array.new<float>(n, na)
    array<float> lows = array.new<float>(n, na)
    array<float> highs = array.new<float>(n, na)
    array<float> volumes = array.new<float>(n, na)
    bool dataValid = true
    bool positivePrices = true
    for i = 0 to n - 1
        int offset = n - 1 - i
        float c = close[offset]
        float l = low[offset]
        float h = high[offset]
        float v = volume[offset]
        array.set(closes, i, c)
        array.set(lows, i, l)
        array.set(highs, i, h)
        array.set(volumes, i, v)
        dataValid := dataValid and not na(c) and not na(l) and not na(h) and not na(v) and not na(open[offset]) and v >= 0
        positivePrices := positivePrices and math.min(open[offset], h, l, c) > 0
    if dataValid
        float price = array.get(closes, n - 1)
        // Exclude current from baseline;allow5..20 previous bars;
        // include current in20-bar average close*volume turnover.
        int baselineCount = math.min(n - 1, 20)
        float baselineTotal = 0.0
        float turnoverTotal = 0.0
        for i = math.max(0, n - 21) to n - 1
            if i < n - 1
                baselineTotal += array.get(volumes, i)
            if i >= math.max(0, n - 20)
                turnoverTotal += array.get(closes, i) * array.get(volumes, i)
        float baseline = baselineCount > 0 ? baselineTotal / baselineCount : na
        float rvol = baseline > 0 ? array.get(volumes, n - 1) / baseline : na
        float turnover = turnoverTotal / math.min(n, 20)
        bool volumeKnown = baselineCount >= 5 and baseline > 0
        bool liquid = volumeKnown and price >= 1.0 and turnover >= 20000000.0
        array.set(metrics, 0, rvol)
        array.set(metrics, 1, turnover)
        array.set(known, 0, volumeKnown)
        array.set(flags, 0, liquid and rvol >= 3.0)
        array<int> periods = array.from(5, 8, 10, 13, 20, 21, 34, 50, 55, 89, 100, 144, 200, 233)
        array<float> ema = array.new<float>(14, array.get(closes, 0))
        array<float> rsiSeries = array.new<float>(n, na)
        float technicalAtr = array.get(highs, 0) - array.get(lows, 0)
        float plusRma = 0.0
        float minusRma = 0.0
        float adxRma = 0.0
        float gainTotal = 0.0
        float lossTotal = 0.0
        float averageGain = na
        float averageLoss = na
        float planTrTotal = 0.0
        float planAtr = na
        float alpha14 = 1.0 / 14.0
        // First-range technicalATR;first0 DM/DX;SMA14 first-delta RSI;
        // planATR excludes first range and seeds SMA14 of TR1..14.
        for i = 0 to n - 1
            float c = array.get(closes, i)
            float h = array.get(highs, i)
            float l = array.get(lows, i)
            float tr = h - l
            if i > 0
                float previousClose = array.get(closes, i - 1)
                tr := math.max(tr, math.abs(h - previousClose), math.abs(l - previousClose))
                technicalAtr := alpha14 * tr + (1.0 - alpha14) * technicalAtr
                float up = h - array.get(highs, i - 1)
                float down = array.get(lows, i - 1) - l
                plusRma := alpha14 * (up > down and up > 0 ? up : 0.0) + (1.0 - alpha14) * plusRma
                minusRma := alpha14 * (down > up and down > 0 ? down : 0.0) + (1.0 - alpha14) * minusRma
                float change = c - previousClose
                float gain = math.max(change, 0.0)
                float loss = math.max(-change, 0.0)
                if i <= 14
                    gainTotal += gain
                    lossTotal += loss
                    planTrTotal += tr
                if i == 14
                    averageGain := gainTotal / 14.0
                    averageLoss := lossTotal / 14.0
                    planAtr := planTrTotal / 14.0
                else if i > 14
                    averageGain := (averageGain * 13.0 + gain) / 14.0
                    averageLoss := (averageLoss * 13.0 + loss) / 14.0
                    planAtr := (planAtr * 13.0 + tr) / 14.0
                for j = 0 to 13
                    float alpha = 2.0 / (array.get(periods, j) + 1.0)
                    array.set(ema, j, alpha * c + (1.0 - alpha) * array.get(ema, j))
            if i >= 14
                float rsi = averageLoss == 0 ? (averageGain > 0 ? 100.0 : 50.0) : 100.0 - 100.0 / (1.0 + averageGain / averageLoss)
                array.set(rsiSeries, i, rsi)
            float dx = 0.0
            if i >= 13 and technicalAtr > 0
                float plusDi = 100.0 * plusRma / technicalAtr
                float minusDi = 100.0 * minusRma / technicalAtr
                float denominator = plusDi + minusDi
                dx := denominator != 0 ? 100.0 * math.abs(plusDi - minusDi) / denominator : 0.0
            if i > 0
                adxRma := alpha14 * dx + (1.0 - alpha14) * adxRma
        array.set(metrics, 17, planAtr)
        if n >= 15 and positivePrices and not na(planAtr) and planAtr > 0
            float swing7Low = array.get(lows, n - 1)
            float swing7High = array.get(highs, n - 1)
            for i = math.max(0, n - 7) to n - 1
                swing7Low := math.min(swing7Low, array.get(lows, i))
                swing7High := math.max(swing7High, array.get(highs, i))
            float longRisk = math.max(price - (swing7Low - 0.2 * planAtr), 0.75 * planAtr)
            float shortRisk = math.max((swing7High + 0.2 * planAtr) - price, 0.75 * planAtr)
            float longStop = price - longRisk
            float shortStop = price + shortRisk
            // Source omits a side if ANY stop/TP level is nonpositive.
            if math.min(longStop, price + longRisk, price + 2.0 * longRisk, price + 3.0 * longRisk) > 0
                array.set(plans, 0, longStop)
                array.set(plans, 1, price + longRisk)
                array.set(plans, 2, price + 2.0 * longRisk)
                array.set(plans, 3, price + 3.0 * longRisk)
            if math.min(shortStop, price - shortRisk, price - 2.0 * shortRisk, price - 3.0 * shortRisk) > 0
                array.set(plans, 4, shortStop)
                array.set(plans, 5, price - shortRisk)
                array.set(plans, 6, price - 2.0 * shortRisk)
                array.set(plans, 7, price - 3.0 * shortRisk)
        if n >= 60
            array<float> widths = array.new<float>(n, na)
            float bbMiddle = na
            float bbDeviation = na
            for i = 19 to n - 1
                float sumClose = 0.0
                for j = i - 19 to i
                    sumClose += array.get(closes, j)
                float mean = sumClose / 20.0
                float squared = 0.0
                for j = i - 19 to i
                    float difference = array.get(closes, j) - mean
                    squared += difference * difference
                float deviation = math.sqrt(squared / 20.0)
                array.set(widths, i, mean != 0 ? 400.0 * deviation / mean : na)
                if i == n - 1
                    bbMiddle := mean
                    bbDeviation := deviation
            float bbRank = na
            int squeezeBars = 0
            // Reverse ranks until the streak ends: mathematically identical
            // to all-ranks-then-reverse;the complete streak is NOT capped.
            for reverse = 0 to n - 20
                int i = n - 1 - reverse
                float currentWidth = array.get(widths, i)
                int validCount = 0
                int belowOrEqual = 0
                for j = math.max(0, i - 99) to i
                    float value = array.get(widths, j)
                    if not na(value)
                        validCount += 1
                        belowOrEqual += value <= currentWidth ? 1 : 0
                float rank = not na(currentWidth) and validCount >= 33 ? float(belowOrEqual) / validCount * 100.0 : na
                if reverse == 0
                    bbRank := rank
                if not na(rank) and rank <= 25.0
                    squeezeBars += 1
                else
                    break
            float rsi = array.get(rsiSeries, n - 1)
            float ema21 = array.get(ema, 5)
            float ema55 = array.get(ema, 8)
            int stackedDirection = price > ema21 and price > ema55 ? 1 : price < ema21 and price < ema55 ? -1 : 0
            int highCount = 0
            int lowCount = 0
            float previousHigh = na
            float lastHigh = na
            float previousLow = na
            float lastLow = na
            // Structure pivots ACCEPT equal neighbours;RSI pivots do not.
            for i = 5 to n - 6
                float centerHigh = array.get(highs, i)
                float centerLow = array.get(lows, i)
                bool highPivot = true
                bool lowPivot = true
                for j = i - 5 to i + 5
                    highPivot := highPivot and centerHigh >= array.get(highs, j)
                    lowPivot := lowPivot and centerLow <= array.get(lows, j)
                if highPivot
                    previousHigh := lastHigh
                    lastHigh := centerHigh
                    highCount += 1
                if lowPivot
                    previousLow := lastLow
                    lastLow := centerLow
                    lowCount += 1
            int structureTone = 2
            float swingHigh = na
            float swingLow = na
            if highCount >= 2 and lowCount >= 2
                bool hh = lastHigh > previousHigh
                bool hl = lastLow > previousLow
                structureTone := hh and hl ? 1 : not hh and not hl ? -1 : 0
                swingHigh := lastHigh
                swingLow := lastLow
            array<float> levels = array.new<float>()
            array<int> families = array.new<int>()
            int bullishPairs = 0
            int bearishPairs = 0
            int includedEmas = 0
            float previousEma = na
            for j = 0 to 13
                if array.get(periods, j) <= n
                    float value = array.get(ema, j)
                    if includedEmas > 0
                        bullishPairs += previousEma > value ? 1 : 0
                        bearishPairs += previousEma < value ? 1 : 0
                    previousEma := value
                    includedEmas += 1
                    array.push(levels, value)
                    array.push(families, 0)
            int pairs = math.max(includedEmas - 1, 1)
            int trendTone = float(bullishPairs) / pairs >= 0.75 ? 1 : float(bearishPairs) / pairs >= 0.75 ? -1 : 0
            [poc, val, vah] = f_r1016_profile(lows, highs, volumes)
            array<float> profileLevels = array.from(poc, val, vah)
            for j = 0 to 2
                float value = array.get(profileLevels, j)
                if not na(value)
                    array.push(levels, value)
                    array.push(families, 1)
            if not na(swingHigh)
                array.push(levels, swingHigh)
                array.push(families, 2)
            if not na(swingLow)
                array.push(levels, swingLow)
                array.push(families, 2)
            array.push(levels, bbMiddle - 2.0 * bbDeviation)
            array.push(families, 3)
            array.push(levels, bbMiddle)
            array.push(families, 3)
            array.push(levels, bbMiddle + 2.0 * bbDeviation)
            array.push(families, 3)
            bool nearConfluence = f_r1016_confluence(levels, families, price, technicalAtr)
            int strongDiv = f_r1016_divergences(rsiSeries, lows, highs, technicalAtr)
            bool failedDown = f_r1016_failed(lows, highs, closes, val, true) or f_r1016_failed(lows, highs, closes, swingLow, true)
            bool failedUp = f_r1016_failed(lows, highs, closes, vah, false) or f_r1016_failed(lows, highs, closes, swingHigh, false)
            float priorLow = array.get(lows, n - 2)
            float priorHigh = array.get(highs, n - 2)
            for i = n - 21 to n - 2
                priorLow := math.min(priorLow, array.get(lows, i))
                priorHigh := math.max(priorHigh, array.get(highs, i))
            bool piercedDown = array.get(lows, n - 1) < priorLow and priorLow <= price
            bool piercedUp = array.get(highs, n - 1) > priorHigh and priorHigh >= price
            int setup = 0
            int setupDirection = 0
            // Preserve the entire native IF/ELIF PRIORITY tree.
            if failedDown and squeezeBars < 8
                setup := 1
                setupDirection := 1
            else if failedUp and squeezeBars < 8
                setup := 2
                setupDirection := -1
            else if squeezeBars >= 3 or adxRma < 18
                setup := 3
            else if structureTone == trendTone and (structureTone == 1 or structureTone == -1) and adxRma >= 20
                setup := 4
                setupDirection := structureTone
            else if strongDiv > 0 and nearConfluence and (rsi <= 35 or rsi >= 65)
                setup := 5
                setupDirection := rsi <= 35 ? 1 : -1
            bool contextKnown = not na(bbRank) and not na(adxRma) and not na(technicalAtr) and technicalAtr > 0
            bool screenKnown = volumeKnown and contextKnown
            for j = 1 to 6
                array.set(known, j, screenKnown)
            array.set(flags, 1, liquid and contextKnown and bbRank <= 20.0 and rvol >= 1.5)
            array.set(flags, 2, liquid and contextKnown and (rsi <= 25.0 or rsi >= 75.0) and rvol >= 1.0)
            array.set(flags, 3, liquid and contextKnown and (piercedDown or piercedUp) and (setup == 1 or setup == 2))
            array.set(flags, 4, liquid and contextKnown and bbRank <= 20.0 and adxRma < 20.0 and setup == 3)
            array.set(flags, 5, liquid and contextKnown and adxRma >= 25.0 and stackedDirection != 0 and rvol >= 1.0 and setup == 4)
            array.set(flags, 6, liquid and contextKnown and (rsi <= 30.0 or rsi >= 70.0) and (piercedDown or piercedUp) and setup == 5)
            array.set(dirs, 2, rsi <= 25.0 ? 1 : -1)
            array.set(dirs, 3, setupDirection == 1 ? 1 : -1)
            array.set(dirs, 5, setupDirection == 1 ? 1 : -1)
            array.set(dirs, 6, setupDirection == 1 ? 1 : -1)
            array.set(metrics, 2, bbRank)
            array.set(metrics, 3, rsi)
            array.set(metrics, 4, adxRma)
            array.set(metrics, 5, technicalAtr)
            array.set(metrics, 6, float(squeezeBars))
            array.set(metrics, 7, float(setup))
            array.set(metrics, 8, float(structureTone))
            array.set(metrics, 9, float(trendTone))
            array.set(metrics, 10, float(strongDiv))
            array.set(metrics, 11, nearConfluence ? 1.0 : 0.0)
            array.set(metrics, 12, poc)
            array.set(metrics, 13, val)
            array.set(metrics, 14, vah)
            array.set(metrics, 15, swingHigh)
            array.set(metrics, 16, swingLow)
    [flags, dirs, known, metrics, plans]

// bit(scanner-1):scanner10=512,scanner16=32768. NEVER count neutral as bullish.
// confirmed MUST be set by caller. Within request.security it is preferable
// to evaluate and offset [1] in the requested context, not barstate.isconfirmed.
f_r1016_masks(array<bool> flags, array<int> directions, array<bool> known, bool confirmed) =>
    int matchedMask = 0
    int bullishMask = 0
    int bearishMask = 0
    int neutralMask = 0
    int knownMask = 0
    for i = 0 to 6
        int bit = int(math.pow(2.0, i + 9))
        if confirmed and array.get(known, i)
            knownMask += bit
        if confirmed and array.get(flags, i)
            matchedMask += bit
            int direction = array.get(directions, i)
            if direction == 1
                bullishMask += bit
            else if direction == -1
                bearishMask += bit
            else
                neutralMask += bit
    [matchedMask, bullishMask, bearishMask, neutralMask, knownMask]

// Global-scope chart integration example(uncomment once):
// r1016FrameBars = input.int(600,"Native snapshot bars10-16",minval=60,maxval=3000)
// [r1016Flags,r1016Directions,r1016Known,r1016Metrics,r1016Plans] = f_r1016_snapshot(r1016FrameBars)
// [mask10_16,bull10_16,bear10_16,neutral10_16,known10_16] = f_r1016_masks(r1016Flags,r1016Directions,r1016Known,barstate.isconfirmed)
// sig10 = barstate.isconfirmed and array.get(r1016Flags,0)
// sig11 = barstate.isconfirmed and array.get(r1016Flags,1)
// sig12 = barstate.isconfirmed and array.get(r1016Flags,2)
// sig13 = barstate.isconfirmed and array.get(r1016Flags,3)
// sig14 = barstate.isconfirmed and array.get(r1016Flags,4)
// sig15 = barstate.isconfirmed and array.get(r1016Flags,5)
// sig16 = barstate.isconfirmed and array.get(r1016Flags,6)
// Plans:bullish[0..3],bearish[4..7],neutral10/11/14 BOTH valid conditional sides.
// Source10/13 are EVENT findings:do not replace by rising-edge state matches.
// Source11/12/14/15/16 are STATE findings;notification policy is separate.
// Use max_bars_back>=requestedBars for OHLCV. Prefer limited recent history
// evaluation to avoid full snapshot recomputation on every chart-history bar.
// If requesting offset[1],compute at least two final bars in that context;
// a recent10-bar evaluation window provides room for previous-state retrieval.
// Calling only barstate.islast can leave the previous requested bar undefined.


// Pine v6 fragment. No indicator(), alert(), order, network, or UI operations.
// Source: config/manual-scanner-names.json, config/scanners.toml;
// src/market_intelligence/features/decision.py, research/ma_levels.py,
// features/ma.py, scanning/decision/panel_v645.py, scanning/ma/near_zone.py.
// TradingView compilation and identical-OHLCV Python/Pine parity are unverified.

// pandas ewm(adjust=false, ignore_na=false): first non-na seed,
// accumulated old weight over internal na gaps, min_periods masking.
// ta.rma/ta.rsi/ta.atr have different seeds; do not substitute them.
f_r17_ewm(float source, simple float alpha, simple int minimumObservations) =>
    float state = na
    float oldWeight = 1.0
    int observations = 0
    state := state[1]
    oldWeight := nz(oldWeight[1], 1.0)
    observations := nz(observations[1], 0)
    if not na(state)
        oldWeight *= 1.0 - alpha
        if not na(source)
            state := (oldWeight * state + alpha * source) / (oldWeight + alpha)
            oldWeight := 1.0
    else if not na(source)
        state := source
        oldWeight := 1.0
    if not na(source)
        observations += 1
    observations >= minimumObservations ? state : na

f_r17_ema(float source, simple int length) =>
    f_r17_ewm(source, 2.0 / (length + 1.0), length)

f_r17_rma(float source, simple int length) =>
    f_r17_ewm(source, 1.0 / length, length)

f_r17_rsi(float source) =>
    float change = ta.change(source)
    float averageGain = f_r17_rma(na(change) ? na : math.max(change, 0.0), 14)
    float averageLoss = f_r17_rma(na(change) ? na : math.max(-change, 0.0), 14)
    averageLoss == 0.0 ? 100.0 : 100.0 - 100.0 / (1.0 + averageGain / averageLoss)

f_r17_points(bool condition, simple int points) =>
    condition ? points : 0

// Evaluate on recent source bars; each evaluation recalculates the exact native frame.
// Tuple: ready, newEntry, score, activeSetup, newSetup, rvol, pct20, adx,
//        pullbackGuard, pullbackBase.
// No barstate.isconfirmed inside security(). Every field must be offset for
// previous-confirmed HTF requests; do not mix a prior flag with a current price.
// ready is false outside exact 1D; no 1h/4h/1W rule17.
// Exact bounded native frame: recursive seeds restart at its first OHLCV row.
// Returns the same ten fields as the old streaming function; never approximates
// a rolling600-frame by the entire TradingView chart history.
f_r17_bounded_ewm(array<float> states, array<float> weights, array<int> counts, int slot, float value, float alpha, int minimum) =>
    float state = array.get(states, slot)
    float weight = array.get(weights, slot)
    int count = array.get(counts, slot)
    if not na(state)
        weight *= 1.0 - alpha
        if not na(value)
            state := (weight * state + alpha * value) / (weight + alpha)
            weight := 1.0
    else if not na(value)
        state := value
        weight := 1.0
    if not na(value)
        count += 1
    array.set(states, slot, state)
    array.set(weights, slot, weight)
    array.set(counts, slot, count)
    count >= minimum ? state : na
f_r17_bounded_at(array<float> values, int index) =>
    index >= 0 and index < array.size(values) ? array.get(values, index) : na
f_r17_bounded_mean(array<float> values, int index, int period) =>
    float total = 0.0
    bool valid = index >= period - 1
    if valid
        for j = index - period + 1 to index
            float value = array.get(values, j)
            valid := valid and not na(value)
            total += nz(value)
    valid ? total / period : na
f_r17_bounded_high(array<float> values, int index, int period) =>
    float highest = na
    bool valid = index >= period - 1
    if valid
        for j = index - period + 1 to index
            float value = array.get(values, j)
            valid := valid and not na(value)
            highest := na(highest) ? value : math.max(highest, value)
    valid ? highest : na
f_r17_frame(int requestedBars) =>
    bool readyResult = false
    bool entryResult = false
    int scoreResult = 0
    string activeResult = ""
    string newResult = ""
    float rvolResult = na
    float pctResult = na
    float adxResult = na
    bool guardResult = false
    bool baseResult = false
    int n = math.min(math.max(requestedBars, 1), bar_index + 1)
    if timeframe.isdaily and timeframe.multiplier == 1 and n >= 252 and last_bar_index - bar_index <= 2
        array<float> opens = array.new<float>()
        array<float> highs = array.new<float>()
        array<float> lows = array.new<float>()
        array<float> closes = array.new<float>()
        array<float> volumes = array.new<float>()
        array<float> turnovers = array.new<float>()
        bool dataValid = true
        for j = 0 to n - 1
            int offset = n - 1 - j
            dataValid := dataValid and not na(open[offset]) and not na(high[offset]) and not na(low[offset]) and not na(close[offset]) and not na(volume[offset]) and volume[offset] >= 0
            array.push(opens, open[offset])
            array.push(highs, high[offset])
            array.push(lows, low[offset])
            array.push(closes, close[offset])
            array.push(volumes, volume[offset])
            array.push(turnovers, close[offset] * volume[offset])
        if dataValid
            array<float> states = array.new<float>(12, na)
            array<float> weights = array.new<float>(12, 1.0)
            array<int> counts = array.new<int>(12, 0)
            array<float> ema5Values = array.new<float>()
            array<float> ema8Values = array.new<float>()
            array<float> ema13Values = array.new<float>()
            array<float> histogramValues = array.new<float>()
            array<float> bbWidths = array.new<float>()
            array<float> distances = array.new<float>()
            bool priorBreakout = false
            bool priorPullback = false
            bool priorTrend = false
            for i = 0 to n - 1
                float c = array.get(closes, i)
                float o = array.get(opens, i)
                float h = array.get(highs, i)
                float l = array.get(lows, i)
                float v = array.get(volumes, i)
                float ema5 = f_r17_bounded_ewm(states, weights, counts, 0, c, 2.0 / 6.0, 5)
                float ema8 = f_r17_bounded_ewm(states, weights, counts, 1, c, 2.0 / 9.0, 8)
                float ema13 = f_r17_bounded_ewm(states, weights, counts, 2, c, 2.0 / 14.0, 13)
                float ema12 = f_r17_bounded_ewm(states, weights, counts, 3, c, 2.0 / 13.0, 12)
                float ema26 = f_r17_bounded_ewm(states, weights, counts, 4, c, 2.0 / 27.0, 26)
                float macd = ema12 - ema26
                float macdSignal = f_r17_bounded_ewm(states, weights, counts, 5, macd, 2.0 / 10.0, 9)
                float histogram = macd - macdSignal
                float change = i > 0 ? c - array.get(closes, i - 1) : na
                float gain = f_r17_bounded_ewm(states, weights, counts, 6, na(change) ? na : math.max(change, 0.0), 1.0 / 14.0, 14)
                float loss = f_r17_bounded_ewm(states, weights, counts, 7, na(change) ? na : math.max(-change, 0.0), 1.0 / 14.0, 14)
                float rsi = loss == 0 ? 100.0 : 100.0 - 100.0 / (1.0 + gain / loss)
                float tr = i == 0 ? h - l : math.max(h - l, math.abs(h - array.get(closes, i - 1)), math.abs(l - array.get(closes, i - 1)))
                float atr = f_r17_bounded_ewm(states, weights, counts, 8, tr, 1.0 / 14.0, 14)
                float up = i > 0 ? h - array.get(highs, i - 1) : na
                float down = i > 0 ? array.get(lows, i - 1) - l : na
                float plusDmRma = f_r17_bounded_ewm(states, weights, counts, 9, up > down and up > 0 ? up : 0.0, 1.0 / 14.0, 14)
                float minusDmRma = f_r17_bounded_ewm(states, weights, counts, 10, down > up and down > 0 ? down : 0.0, 1.0 / 14.0, 14)
                float plusDi = atr != 0 ? 100.0 * plusDmRma / atr : na
                float minusDi = atr != 0 ? 100.0 * minusDmRma / atr : na
                float diSum = plusDi + minusDi
                float dx = diSum != 0 ? 100.0 * math.abs(plusDi - minusDi) / diSum : na
                float adx = f_r17_bounded_ewm(states, weights, counts, 11, dx, 1.0 / 14.0, 14)
                float sma20 = f_r17_bounded_mean(closes, i, 20)
                float deviation = na
                if i >= 19
                    float squared = 0.0
                    for j = i - 19 to i
                        squared += math.pow(array.get(closes, j) - sma20, 2)
                    deviation := math.sqrt(squared / 20.0)
                float bbWidth = sma20 != 0 ? 400.0 * deviation / sma20 : na
                float distanceAtr = atr != 0 ? (c - sma20) / atr : na
                array.push(ema5Values, ema5)
                array.push(ema8Values, ema8)
                array.push(ema13Values, ema13)
                array.push(histogramValues, histogram)
                array.push(bbWidths, bbWidth)
                array.push(distances, distanceAtr)
                if i >= n - 2
                    float sma50 = f_r17_bounded_mean(closes, i, 50)
                    float sma200 = f_r17_bounded_mean(closes, i, 200)
                    float slope20 = (sma20 / f_r17_bounded_mean(closes, i - 5, 20) - 1.0) * 100.0
                    float slope50 = (sma50 / f_r17_bounded_mean(closes, i - 10, 50) - 1.0) * 100.0
                    float slope200 = (sma200 / f_r17_bounded_mean(closes, i - 20, 200) - 1.0) * 100.0
                    bool priceAbove20 = c > sma20
                    bool sma20Above50 = sma20 > sma50
                    bool sma50Above200 = sma50 > sma200
                    bool slope20Ok = slope20 >= 0.0
                    bool slope50Ok = slope50 >= 0.0
                    bool slope200Ok = slope200 >= -0.5
                    bool trendCore = priceAbove20 and sma20Above50 and sma50Above200 and slope20Ok and slope50Ok and slope200Ok
                    bool ema5Up = ema5 > f_r17_bounded_at(ema5Values, i - 1)
                    bool ema8Up = ema8 > f_r17_bounded_at(ema8Values, i - 1)
                    bool ema13Up = ema13 > f_r17_bounded_at(ema13Values, i - 1)
                    bool shortAligned = ema5 > ema8 and ema8 > ema13
                    bool shortSlopes = ema5Up and ema8Up and ema13Up
                    bool shortTrend = shortAligned and shortSlopes
                    bool shortRecovery = (ema5 > ema8 and f_r17_bounded_at(ema5Values, i - 1) <= f_r17_bounded_at(ema8Values, i - 1)) or (ema5 > ema8 and ema5Up and ema8Up)

                    bool macdAboveSignal = macd > macdSignal
                    bool macdAboveZero = macd > 0.0
                    bool histPositive = histogram > 0.0
                    bool histNegative = histogram < 0.0
                    bool histRising = histogram > f_r17_bounded_at(histogramValues, i - 1)
                    bool histFalling = histogram < f_r17_bounded_at(histogramValues, i - 1)
                    bool histCrossUp = histPositive and f_r17_bounded_at(histogramValues, i - 1) <= 0.0
                    bool histBullStrengthening = histPositive and histRising
                    bool histBullWeakening = histPositive and histFalling
                    bool histBearRecovering = histNegative and histRising
                    bool rsiTrendOk = rsi >= 55.0 and rsi <= 72.0
                    bool rsiPullbackOk = rsi >= 50.0 and rsi <= 72.0
                    bool rsiIdeal = rsi >= 55.0 and rsi <= 68.0

                    bool strengthCore = adx > 20.0 and plusDi > minusDi
                    bool diOk = plusDi > minusDi
                    float atrPct = c != 0.0 ? atr / c * 100.0 : na
                    bool atrPctOk = atrPct >= 1.5 and atrPct <= 7.0

                    float averageVolume = f_r17_bounded_mean(volumes, i - 1, 10)
                    float rvol = averageVolume != 0.0 ? v / averageVolume : na
                    float turnover = c * v
                    float averageTurnover = f_r17_bounded_mean(turnovers, i - 1, 20)
                    float relativeTurnover = averageTurnover != 0.0 ? turnover / averageTurnover : na
                    float high52 = f_r17_bounded_high(highs, i, 252)
                    float high20 = f_r17_bounded_high(highs, i, 20)
                    float pct52 = high52 != 0.0 ? c / high52 * 100.0 : na
                    float pct20 = high20 != 0.0 ? c / high20 * 100.0 : na
                    bool near52 = pct52 >= 85.0
                    bool near20 = pct20 >= 95.0
                    bool breakout20 = c > f_r17_bounded_high(highs, i - 1, 20)
                    bool participationOk = rvol > (breakout20 ? 1.50 : 1.20)
                    float distancePct = sma20 != 0.0 ? (c / sma20 - 1.0) * 100.0 : na
                    bool distanceCore = distancePct >= 0.0 and distancePct <= 7.0 and distanceAtr >= 0.0 and distanceAtr <= 1.50
                    bool bbWidthRising = bbWidth > f_r17_bounded_at(bbWidths, i - 1)
                    bool bbWidthAboveAverage = bbWidth > f_r17_bounded_mean(bbWidths, i, 20)
                    float candleRange = h - l
                    float clv = candleRange != 0.0 ? (c - l) / candleRange : 0.5
                    float upperWick = h - math.max(o, c)
                    bool breakoutQuality = bbWidthRising and clv >= 0.60 and upperWick / atr <= 0.50
                    bool wasAboveSma20 = f_r17_bounded_high(distances, i - 1, 10) >= 0.75
                    bool sma20Touched = l <= sma20 + 0.25 * atr and l >= sma20 - 0.50 * atr
                    bool pullbackBase = not breakout20 and wasAboveSma20 and sma20Touched and c > sma20 and distanceAtr <= 1.0 and (c > o or clv >= 0.60)
                    bool pullbackMomentum = macdAboveZero and rsiPullbackOk and (histBearRecovering or histCrossUp or histBullStrengthening)
                    bool breakoutMomentum = macdAboveSignal and macdAboveZero and rsiTrendOk and (histBullStrengthening or histCrossUp)

                    int trendScore = f_r17_points(priceAbove20, 4) + f_r17_points(sma20Above50, 4) + f_r17_points(sma50Above200, 4) + f_r17_points(slope20Ok, 3) + f_r17_points(slope50Ok, 3) + f_r17_points(slope200 > 0.0, 2) + f_r17_points(shortAligned, 3) + f_r17_points(shortSlopes, 2)
                    int histogramScore = histCrossUp ? 6 : histBullStrengthening ? 6 : histBearRecovering ? 4 : histBullWeakening ? 2 : 0
                    int momentumScore = f_r17_points(macdAboveZero, 4) + f_r17_points(macdAboveSignal, 5) + histogramScore + f_r17_points(rsiIdeal, 5)
                    int volumeScore = (rvol >= 3.0 ? 18 : rvol >= 2.0 ? 16 : rvol >= 1.5 ? 12 : rvol >= 1.2 ? 7 : rvol >= 1.0 ? 3 : 0) + f_r17_points(relativeTurnover >= 1.0, 2)
                    int strengthScore = (adx >= 40.0 ? 7 : adx >= 30.0 ? 6 : adx >= 25.0 ? 5 : adx > 20.0 ? 3 : 0) + f_r17_points(diOk, 3)
                    int locationScore = (pct52 >= 95.0 ? 7 : pct52 >= 90.0 ? 5 : pct52 >= 85.0 ? 3 : 0) + f_r17_points(near20, 3)
                    int distanceScore = (distancePct >= 0.0 and distancePct <= 3.0 ? 5 : distancePct > 3.0 and distancePct <= 5.0 ? 4 : distancePct > 5.0 and distancePct <= 7.0 ? 2 : 0) + (distanceAtr >= 0.0 and distanceAtr < 1.0 ? 5 : distanceAtr >= 1.0 and distanceAtr <= 1.5 ? 4 : distanceAtr > 1.5 and distanceAtr <= 2.0 ? 2 : 0)
                    int volatilityScore = f_r17_points(bbWidthRising, 2) + f_r17_points(bbWidthAboveAverage, 1) + f_r17_points(atrPctOk, 2)
                    int score = trendScore + momentumScore + volumeScore + strengthScore + locationScore + distanceScore + volatilityScore

                    bool ready = i >= 251 and not na(f_r17_bounded_mean(closes, i - 20, 200)) and not na(rsi) and not na(atr) and atr > 0 and not na(high52)
                    bool structure = trendCore and strengthCore and near52
                    bool common = ready and structure and participationOk and distanceCore and score >= 75
                    bool breakout = common and breakout20 and shortTrend and breakoutMomentum and breakoutQuality
                    bool pullbackGuard = rvol <= 2.0 and pct20 >= 95.0
                    bool pullback = common and pullbackBase and pullbackMomentum and (shortRecovery or shortTrend) and pullbackGuard
                    bool trend = common and not breakout20 and not pullbackBase and shortTrend and breakoutMomentum
                    bool newBreakout = breakout and not priorBreakout
                    bool newPullback = pullback and not priorPullback
                    bool newTrend = trend and not priorTrend
                    string activeSetup = breakout ? "BREAKOUT" : pullback ? "PULLBACK" : trend ? "TREND DEVAMI" : ""
                    string newSetup = newBreakout ? "BREAKOUT" : newPullback ? "PULLBACK" : newTrend ? "TREND DEVAMI" : ""
                    priorBreakout := breakout
                    priorPullback := pullback
                    priorTrend := trend
                    if i == n - 1
                        readyResult := ready
                        entryResult := newSetup != ""
                        scoreResult := score
                        activeResult := activeSetup
                        newResult := newSetup
                        rvolResult := nz(rvol, 0.0)
                        pctResult := nz(pct20, 0.0)
                        adxResult := nz(adx, 0.0)
                        guardResult := pullbackGuard
                        baseResult := pullbackBase
    [readyResult, entryResult, scoreResult, activeResult, newResult, rvolResult, pctResult, adxResult, guardResult, baseResult]

// Separate bearish Rule17: ratio-reflection low/close; no relabeling.
f_r17_bounded_low(array<float> values, int index, int period) =>
    float lowest = na
    bool valid = index >= period - 1
    if valid
        for j = index - period + 1 to index
            float value = array.get(values, j)
            valid := valid and not na(value)
            lowest := na(lowest) ? value : math.min(lowest, value)
    valid ? lowest : na

f_r17_bear_frame(int requestedBars) =>
    bool readyResult = false
    bool entryResult = false
    int scoreResult = 0
    string activeResult = ""
    string newResult = ""
    float rvolResult = na
    float pctResult = na
    float adxResult = na
    bool guardResult = false
    bool baseResult = false
    int n = math.min(math.max(requestedBars, 1), bar_index + 1)
    if timeframe.isdaily and timeframe.multiplier == 1 and n >= 252 and last_bar_index - bar_index <= 2
        array<float> opens = array.new<float>()
        array<float> highs = array.new<float>()
        array<float> lows = array.new<float>()
        array<float> closes = array.new<float>()
        array<float> volumes = array.new<float>()
        array<float> turnovers = array.new<float>()
        bool dataValid = true
        for j = 0 to n - 1
            int offset = n - 1 - j
            dataValid := dataValid and not na(open[offset]) and not na(high[offset]) and not na(low[offset]) and not na(close[offset]) and not na(volume[offset]) and volume[offset] >= 0
            array.push(opens, open[offset])
            array.push(highs, high[offset])
            array.push(lows, low[offset])
            array.push(closes, close[offset])
            array.push(volumes, volume[offset])
            array.push(turnovers, close[offset] * volume[offset])
        if dataValid
            array<float> states = array.new<float>(12, na)
            array<float> weights = array.new<float>(12, 1.0)
            array<int> counts = array.new<int>(12, 0)
            array<float> ema5Values = array.new<float>()
            array<float> ema8Values = array.new<float>()
            array<float> ema13Values = array.new<float>()
            array<float> histogramValues = array.new<float>()
            array<float> bbWidths = array.new<float>()
            array<float> distances = array.new<float>()
            bool priorBreakout = false
            bool priorPullback = false
            bool priorTrend = false
            for i = 0 to n - 1
                float c = array.get(closes, i)
                float o = array.get(opens, i)
                float h = array.get(highs, i)
                float l = array.get(lows, i)
                float v = array.get(volumes, i)
                float ema5 = f_r17_bounded_ewm(states, weights, counts, 0, c, 2.0 / 6.0, 5)
                float ema8 = f_r17_bounded_ewm(states, weights, counts, 1, c, 2.0 / 9.0, 8)
                float ema13 = f_r17_bounded_ewm(states, weights, counts, 2, c, 2.0 / 14.0, 13)
                float ema12 = f_r17_bounded_ewm(states, weights, counts, 3, c, 2.0 / 13.0, 12)
                float ema26 = f_r17_bounded_ewm(states, weights, counts, 4, c, 2.0 / 27.0, 26)
                float macd = ema12 - ema26
                float macdSignal = f_r17_bounded_ewm(states, weights, counts, 5, macd, 2.0 / 10.0, 9)
                float histogram = macd - macdSignal
                float change = i > 0 ? c - array.get(closes, i - 1) : na
                float gain = f_r17_bounded_ewm(states, weights, counts, 6, na(change) ? na : math.max(change, 0.0), 1.0 / 14.0, 14)
                float loss = f_r17_bounded_ewm(states, weights, counts, 7, na(change) ? na : math.max(-change, 0.0), 1.0 / 14.0, 14)
                float rsi = loss == 0 ? 100.0 : 100.0 - 100.0 / (1.0 + gain / loss)
                float tr = i == 0 ? h - l : math.max(h - l, math.abs(h - array.get(closes, i - 1)), math.abs(l - array.get(closes, i - 1)))
                float atr = f_r17_bounded_ewm(states, weights, counts, 8, tr, 1.0 / 14.0, 14)
                float up = i > 0 ? h - array.get(highs, i - 1) : na
                float down = i > 0 ? array.get(lows, i - 1) - l : na
                float plusDmRma = f_r17_bounded_ewm(states, weights, counts, 9, up > down and up > 0 ? up : 0.0, 1.0 / 14.0, 14)
                float minusDmRma = f_r17_bounded_ewm(states, weights, counts, 10, down > up and down > 0 ? down : 0.0, 1.0 / 14.0, 14)
                float plusDi = atr != 0 ? 100.0 * plusDmRma / atr : na
                float minusDi = atr != 0 ? 100.0 * minusDmRma / atr : na
                float diSum = plusDi + minusDi
                float dx = diSum != 0 ? 100.0 * math.abs(plusDi - minusDi) / diSum : na
                float adx = f_r17_bounded_ewm(states, weights, counts, 11, dx, 1.0 / 14.0, 14)
                float sma20 = f_r17_bounded_mean(closes, i, 20)
                float deviation = na
                if i >= 19
                    float squared = 0.0
                    for j = i - 19 to i
                        squared += math.pow(array.get(closes, j) - sma20, 2)
                    deviation := math.sqrt(squared / 20.0)
                float bbWidth = sma20 != 0 ? 400.0 * deviation / sma20 : na
                float distanceAtr = atr != 0 ? (sma20 - c) / atr : na
                array.push(ema5Values, ema5)
                array.push(ema8Values, ema8)
                array.push(ema13Values, ema13)
                array.push(histogramValues, histogram)
                array.push(bbWidths, bbWidth)
                array.push(distances, distanceAtr)
                if i >= n - 2
                    float sma50 = f_r17_bounded_mean(closes, i, 50)
                    float sma200 = f_r17_bounded_mean(closes, i, 200)
                    float slope20 = (sma20 / f_r17_bounded_mean(closes, i - 5, 20) - 1.0) * 100.0
                    float slope50 = (sma50 / f_r17_bounded_mean(closes, i - 10, 50) - 1.0) * 100.0
                    float slope200 = (sma200 / f_r17_bounded_mean(closes, i - 20, 200) - 1.0) * 100.0
                    bool priceAbove20 = c < sma20
                    bool sma20Above50 = sma20 < sma50
                    bool sma50Above200 = sma50 < sma200
                    bool slope20Ok = slope20 <= 0.0
                    bool slope50Ok = slope50 <= 0.0
                    bool slope200Ok = slope200 <= 0.5
                    bool trendCore = priceAbove20 and sma20Above50 and sma50Above200 and slope20Ok and slope50Ok and slope200Ok
                    bool ema5Up = ema5 < f_r17_bounded_at(ema5Values, i - 1)
                    bool ema8Up = ema8 < f_r17_bounded_at(ema8Values, i - 1)
                    bool ema13Up = ema13 < f_r17_bounded_at(ema13Values, i - 1)
                    bool shortAligned = ema5 < ema8 and ema8 < ema13
                    bool shortSlopes = ema5Up and ema8Up and ema13Up
                    bool shortTrend = shortAligned and shortSlopes
                    bool shortRecovery = (ema5 < ema8 and f_r17_bounded_at(ema5Values, i - 1) >= f_r17_bounded_at(ema8Values, i - 1)) or (ema5 < ema8 and ema5Up and ema8Up)

                    bool macdAboveSignal = macd < macdSignal
                    bool macdAboveZero = macd < 0.0
                    bool histPositive = histogram < 0.0
                    bool histNegative = histogram > 0.0
                    bool histRising = histogram < f_r17_bounded_at(histogramValues, i - 1)
                    bool histFalling = histogram > f_r17_bounded_at(histogramValues, i - 1)
                    bool histCrossUp = histPositive and f_r17_bounded_at(histogramValues, i - 1) >= 0.0
                    bool histBullStrengthening = histPositive and histRising
                    bool histBullWeakening = histPositive and histFalling
                    bool histBearRecovering = histNegative and histRising
                    bool rsiTrendOk = rsi >= 28.0 and rsi <= 45.0
                    bool rsiPullbackOk = rsi >= 28.0 and rsi <= 50.0
                    bool rsiIdeal = rsi >= 32.0 and rsi <= 45.0

                    bool strengthCore = adx > 20.0 and minusDi > plusDi
                    bool diOk = minusDi > plusDi
                    float atrPct = c != 0.0 ? atr / c * 100.0 : na
                    bool atrPctOk = atrPct >= 1.5 and atrPct <= 7.0

                    float averageVolume = f_r17_bounded_mean(volumes, i - 1, 10)
                    float rvol = averageVolume != 0.0 ? v / averageVolume : na
                    float turnover = c * v
                    float averageTurnover = f_r17_bounded_mean(turnovers, i - 1, 20)
                    float relativeTurnover = averageTurnover != 0.0 ? turnover / averageTurnover : na
                    float high52 = f_r17_bounded_low(lows, i, 252)
                    float high20 = f_r17_bounded_low(lows, i, 20)
                    float pct52 = high52 != 0.0 ? high52 / c * 100.0 : na
                    float pct20 = high20 != 0.0 ? high20 / c * 100.0 : na
                    bool near52 = pct52 >= 85.0
                    bool near20 = pct20 >= 95.0
                    bool breakout20 = c < f_r17_bounded_low(lows, i - 1, 20)
                    bool participationOk = rvol > (breakout20 ? 1.50 : 1.20)
                    float distancePct = sma20 != 0.0 ? (1.0 - c / sma20) * 100.0 : na
                    bool distanceCore = distancePct >= 0.0 and distancePct <= 7.0 and distanceAtr >= 0.0 and distanceAtr <= 1.50
                    bool bbWidthRising = bbWidth > f_r17_bounded_at(bbWidths, i - 1)
                    bool bbWidthAboveAverage = bbWidth > f_r17_bounded_mean(bbWidths, i, 20)
                    float candleRange = h - l
                    float clv = candleRange != 0.0 ? (c - l) / candleRange : 0.5
                    float upperWick = math.min(o, c) - l
                    bool breakoutQuality = bbWidthRising and clv <= 0.40 and upperWick / atr <= 0.50
                    bool wasAboveSma20 = f_r17_bounded_high(distances, i - 1, 10) >= 0.75
                    bool sma20Touched = h >= sma20 - 0.25 * atr and h <= sma20 + 0.50 * atr
                    bool pullbackBase = not breakout20 and wasAboveSma20 and sma20Touched and c < sma20 and distanceAtr <= 1.0 and (c < o or clv <= 0.40)
                    bool pullbackMomentum = macdAboveZero and rsiPullbackOk and (histBearRecovering or histCrossUp or histBullStrengthening)
                    bool breakoutMomentum = macdAboveSignal and macdAboveZero and rsiTrendOk and (histBullStrengthening or histCrossUp)

                    int trendScore = f_r17_points(priceAbove20, 4) + f_r17_points(sma20Above50, 4) + f_r17_points(sma50Above200, 4) + f_r17_points(slope20Ok, 3) + f_r17_points(slope50Ok, 3) + f_r17_points(slope200 < 0.0, 2) + f_r17_points(shortAligned, 3) + f_r17_points(shortSlopes, 2)
                    int histogramScore = histCrossUp ? 6 : histBullStrengthening ? 6 : histBearRecovering ? 4 : histBullWeakening ? 2 : 0
                    int momentumScore = f_r17_points(macdAboveZero, 4) + f_r17_points(macdAboveSignal, 5) + histogramScore + f_r17_points(rsiIdeal, 5)
                    int volumeScore = (rvol >= 3.0 ? 18 : rvol >= 2.0 ? 16 : rvol >= 1.5 ? 12 : rvol >= 1.2 ? 7 : rvol >= 1.0 ? 3 : 0) + f_r17_points(relativeTurnover >= 1.0, 2)
                    int strengthScore = (adx >= 40.0 ? 7 : adx >= 30.0 ? 6 : adx >= 25.0 ? 5 : adx > 20.0 ? 3 : 0) + f_r17_points(diOk, 3)
                    int locationScore = (pct52 >= 95.0 ? 7 : pct52 >= 90.0 ? 5 : pct52 >= 85.0 ? 3 : 0) + f_r17_points(near20, 3)
                    int distanceScore = (distancePct >= 0.0 and distancePct <= 3.0 ? 5 : distancePct > 3.0 and distancePct <= 5.0 ? 4 : distancePct > 5.0 and distancePct <= 7.0 ? 2 : 0) + (distanceAtr >= 0.0 and distanceAtr < 1.0 ? 5 : distanceAtr >= 1.0 and distanceAtr <= 1.5 ? 4 : distanceAtr > 1.5 and distanceAtr <= 2.0 ? 2 : 0)
                    int volatilityScore = f_r17_points(bbWidthRising, 2) + f_r17_points(bbWidthAboveAverage, 1) + f_r17_points(atrPctOk, 2)
                    int score = trendScore + momentumScore + volumeScore + strengthScore + locationScore + distanceScore + volatilityScore

                    bool ready = i >= 251 and not na(f_r17_bounded_mean(closes, i - 20, 200)) and not na(rsi) and not na(atr) and atr > 0 and not na(high52)
                    bool structure = trendCore and strengthCore and near52
                    bool common = ready and structure and participationOk and distanceCore and score >= 75
                    bool breakout = common and breakout20 and shortTrend and breakoutMomentum and breakoutQuality
                    bool pullbackGuard = rvol <= 2.0 and pct20 >= 95.0
                    bool pullback = common and pullbackBase and pullbackMomentum and (shortRecovery or shortTrend) and pullbackGuard
                    bool trend = common and not breakout20 and not pullbackBase and shortTrend and breakoutMomentum
                    bool newBreakout = breakout and not priorBreakout
                    bool newPullback = pullback and not priorPullback
                    bool newTrend = trend and not priorTrend
                    string activeSetup = breakout ? "BREAKDOWN" : pullback ? "BEAR RETEST" : trend ? "BEAR TREND" : ""
                    string newSetup = newBreakout ? "BREAKDOWN" : newPullback ? "BEAR RETEST" : newTrend ? "BEAR TREND" : ""
                    priorBreakout := breakout
                    priorPullback := pullback
                    priorTrend := trend
                    if i == n - 1
                        readyResult := ready
                        entryResult := newSetup != ""
                        scoreResult := score
                        activeResult := activeSetup
                        newResult := newSetup
                        rvolResult := nz(rvol, 0.0)
                        pctResult := nz(pct20, 0.0)
                        adxResult := nz(adx, 0.0)
                        guardResult := pullbackGuard
                        baseResult := pullbackBase
    [readyResult, entryResult, scoreResult, activeResult, newResult, rvolResult, pctResult, adxResult, guardResult, baseResult]

// Same-timeframe 1D chart consumer. Call each bar. available is distinct from
// entry=false; a non-confirmed daily bar has no closed rule17 snapshot.
f_r17_closed_chart() =>
    [ready, entry, score, activeSetup, newSetup, rvol, pct20, adx, guard, base] = f_r17_frame(600)
    bool available = ready and barstate.isconfirmed
    [available, available and entry, score, activeSetup, newSetup, rvol, pct20, adx, guard, base]

// INTRADAY consumer: request only from "1D" with lookahead_on. EVERY field is
// offset. This reports the prior completed daily event at the next daily period.
// Do not label it a 1h/4h/1W rule17; deduplicate by returned source time_close.
f_r17_previous_daily() =>
    [ready, entry, score, activeSetup, newSetup, rvol, pct20, adx, guard, base] = f_r17_frame(600)
    [ready[1], entry[1], score[1], activeSetup[1], newSetup[1], rvol[1], pct20[1], adx[1], guard[1], base[1], time_close[1]]

// RULE18: qualified observations must come from the historical research port
// below or a provenance-backed Python snapshot. Raw MA proximity is insufficient.
// The selection stage preserves Python quality/distance ranking and stable ties.
type R18QualifiedObservation
    string maType
    int period
    float value
    string qualificationSide
    string levelClass
    int touches
    float qualityScore
    string researchVersion
    bool activeSide

f_r18_insert_top_two(array<int> selected, int candidateIndex, array<R18QualifiedObservation> observations, float price, float atr) =>
    R18QualifiedObservation candidate = array.get(observations, candidateIndex)
    float candidateDistance = math.abs((candidate.value - price) / atr)
    int insertion = array.size(selected)
    if array.size(selected) > 0
        for rank = 0 to array.size(selected) - 1
            R18QualifiedObservation existing = array.get(observations, array.get(selected, rank))
            float existingDistance = math.abs((existing.value - price) / atr)
            if candidate.qualityScore > existing.qualityScore or (candidate.qualityScore == existing.qualityScore and candidateDistance < existingDistance)
                insertion := rank
                break
    array.insert(selected, insertion, candidateIndex)
    if array.size(selected) > 2
        array.pop(selected)
    array.size(selected)

// Outputs: known, supportIndices(bullish), resistanceIndices(bearish).
// Both sides may be present. ResultKind.STATE, not entry EVENT.
// Equal-score/equal-distance ties retain original observation order.
// validUntilMs=0 means no explicit end; validity end is EXCLUSIVE.
// snapshotKnown is provenance-backed availability, never a confidence vote.
// The caller must not enable this with an unqualified MA proximity calculation.
f_r18_select(bool snapshotKnown, string snapshotTickerId, string snapshotTf, int validFromMs, int validUntilMs, bool identicalHistoryAndBasis, array<R18QualifiedObservation> observations, float price, float atr, int sourceBarCloseMs, bool sourceBarClosed) =>
    array<int> support = array.new<int>()
    array<int> resistance = array.new<int>()
    bool configuredTf = timeframe.period == "60" or timeframe.period == "240" or (timeframe.isdaily and timeframe.multiplier == 1) or (timeframe.isweekly and timeframe.multiplier == 1) or (timeframe.ismonthly and timeframe.multiplier == 1)
    bool validity = validFromMs <= sourceBarCloseMs and (validUntilMs == 0 or sourceBarCloseMs < validUntilMs)
    bool known = snapshotKnown and identicalHistoryAndBasis and sourceBarClosed and configuredTf and snapshotTickerId == syminfo.tickerid and snapshotTf == timeframe.period and validity and not na(price) and not na(atr) and atr > 0.0
    if known and array.size(observations) > 0
        for index = 0 to array.size(observations) - 1
            R18QualifiedObservation item = array.get(observations, index)
            string side = item.value <= price ? "support" : "resistance"
            bool qualifiedSide = item.qualificationSide == "both" or item.qualificationSide == side
            bool acceptedClass = item.levelClass == "strong_level" or item.levelClass == "level"
            bool metadata = item.period >= 2 and item.touches >= 0 and item.researchVersion != "" and not na(item.qualityScore)
            bool near = not na(item.value) and math.abs((item.value - price) / atr) <= 1.0
            if item.activeSide and qualifiedSide and acceptedClass and metadata and near
                if side == "support"
                    f_r18_insert_top_two(support, index, observations, price, atr)
                else
                    f_r18_insert_top_two(resistance, index, observations, price, atr)
    [known, support, resistance]


// RULE18 native historical MA research, matching Python default MaResearchConfig.
// Port target: research/ma_levels.py + features/ma.py + scanning/ma/near_zone.py.
// No extra request.security context is created. The caller supplies one closed
// OHLCV frame with the same rolling history used by the native Python executor.
// Formula port; same-feed numerical parity and TradingView runtime still require
// validation. Never change all_rules_parity_verified because this code compiles.

f_r18_wma(array<float> values, int period) =>
    int n = array.size(values)
    array<float> result = array.new<float>(n, na)
    if n >= period
        float denominator = period * (period + 1) / 2.0
        float windowSum = 0.0
        float weightedSum = 0.0
        for i = 0 to period - 1
            float value = array.get(values, i)
            windowSum += value
            weightedSum += (i + 1) * value
        array.set(result, period - 1, weightedSum / denominator)
        if n > period
            for i = period to n - 1
                float previousSum = windowSum
                windowSum += array.get(values, i) - array.get(values, i - period)
                weightedSum += period * array.get(values, i) - previousSum
                array.set(result, i, weightedSum / denominator)
    result

f_r18_ma(string kind, array<float> closes, array<float> volumes, int period) =>
    int n = array.size(closes)
    array<float> result = array.new<float>(n, na)
    if n >= period
        if kind == "SMA"
            float rolling = 0.0
            for i = 0 to period - 1
                rolling += array.get(closes, i)
            array.set(result, period - 1, rolling / period)
            if n > period
                for i = period to n - 1
                    rolling += array.get(closes, i) - array.get(closes, i - period)
                    array.set(result, i, rolling / period)
        else if kind == "EMA"
            float alpha = 2.0 / (period + 1.0)
            float current = array.get(closes, 0)
            for i = 0 to n - 1
                if i > 0
                    current := alpha * array.get(closes, i) + (1.0 - alpha) * current
                if i >= period - 1
                    array.set(result, i, current)
        else if kind == "WMA"
            result := f_r18_wma(closes, period)
        else if kind == "VWMA"
            float denominator = 0.0
            float numerator = 0.0
            for i = 0 to period - 1
                denominator += array.get(volumes, i)
                numerator += array.get(closes, i) * array.get(volumes, i)
            if denominator > 0.0
                array.set(result, period - 1, numerator / denominator)
            if n > period
                for i = period to n - 1
                    denominator += array.get(volumes, i) - array.get(volumes, i - period)
                    numerator += array.get(closes, i) * array.get(volumes, i)
                    numerator -= array.get(closes, i - period) * array.get(volumes, i - period)
                    if denominator > 0.0
                        array.set(result, i, numerator / denominator)
        else if kind == "KAMA"
            float current = 0.0
            for i = 0 to period - 1
                current += array.get(closes, i)
            current /= period
            array.set(result, period - 1, current)
            float volatility = 0.0
            if n > period
                for i = 1 to period
                    volatility += math.abs(array.get(closes, i) - array.get(closes, i - 1))
                for i = period to n - 1
                    float change = math.abs(array.get(closes, i) - array.get(closes, i - period))
                    if i > period
                        volatility += math.abs(array.get(closes, i) - array.get(closes, i - 1))
                        volatility -= math.abs(array.get(closes, i - period) - array.get(closes, i - period - 1))
                    float efficiency = volatility > 0.0 ? change / volatility : 0.0
                    float smoothing = math.pow(efficiency * (2.0 / 3.0 - 2.0 / 31.0) + 2.0 / 31.0, 2.0)
                    current += smoothing * (array.get(closes, i) - current)
                    array.set(result, i, current)
        else if kind == "ALMA"
            float center = 0.85 * (period - 1)
            float width = period / 6.0
            array<float> weights = array.new<float>(period, na)
            float denominator = 0.0
            for j = 0 to period - 1
                float weight = math.exp(-math.pow(j - center, 2.0) / (2.0 * width * width))
                array.set(weights, j, weight)
                denominator += weight
            for i = period - 1 to n - 1
                float numerator = 0.0
                for j = 0 to period - 1
                    numerator += array.get(closes, i - period + 1 + j) * array.get(weights, j)
                array.set(result, i, numerator / denominator)
        else if kind == "HMA"
            int half = math.max(2, int(math.floor(period / 2.0)))
            int root = math.max(2, int(math.sqrt(period)))
            array<float> halfValues = f_r18_wma(closes, half)
            array<float> fullValues = f_r18_wma(closes, period)
            array<float> combined = array.new<float>()
            array<int> positions = array.new<int>()
            for i = 0 to n - 1
                float halfValue = array.get(halfValues, i)
                float fullValue = array.get(fullValues, i)
                if not na(halfValue) and not na(fullValue)
                    array.push(combined, 2.0 * halfValue - fullValue)
                    array.push(positions, i)
            array<float> smoothed = f_r18_wma(combined, root)
            if array.size(positions) > 0
                for i = 0 to array.size(positions) - 1
                    array.set(result, array.get(positions, i), array.get(smoothed, i))
    result

f_r18_median(array<float> values) =>
    int count = array.size(values)
    float result = na
    if count > 0
        array.sort(values, order.ascending)
        int middle = int(math.floor(count / 2.0))
        result := count % 2 == 1 ? array.get(values, middle) : (array.get(values, middle - 1) + array.get(values, middle)) / 2.0
    result

// Python round(score,2): recover multiplication rounding error with a split
// product, then apply ties-to-even to the exact binary score times 100. This
// handles 2.675->2.67 and 2.685->2.69, unlike plain math.round(score*100).
f_r18_round_score(float score) =>
    float scaled = score * 100.0
    float split = 134217729.0 * score
    float highPart = split - (split - score)
    float lowPart = score - highPart
    float productError = (highPart * 100.0 - scaled) + lowPart * 100.0
    float lower = math.floor(scaled)
    float fromTie = (scaled - lower - 0.5) + productError
    float rounded = fromTie > 0.0 ? lower + 1.0 : fromTie < 0.0 ? lower : int(lower) % 2 == 0 ? lower : lower + 1.0
    [rounded / 100.0, false]

// Historical touch boundary deliberately excludes the final 23 bars exactly as
// Python range(1, len(frame.bars) - independence_bars - 2) does for defaults.
f_r18_side_research(array<float> closes, array<float> highs, array<float> lows, array<float> moving, array<float> atrs, int side, int validBars, int crossCount) =>
    int n = array.size(closes)
    bool wasFar = false
    bool previousInZone = false
    int lastTouch = -1000000000
    array<float> bounces = array.new<float>()
    int held = 0
    int holds = 0
    if n >= 24
        for i = 1 to n - 23
            float value = array.get(moving, i)
            float atr = array.get(atrs, i)
            if na(value) or na(atr) or atr <= 0.0
                wasFar := false
                previousInZone := false
            else
                float signedDistance = (array.get(closes, i) - value) / atr
                float zone = 0.20 * atr
                bool inZone = array.get(lows, i) <= value + zone and array.get(highs, i) >= value - zone
                if not inZone
                    if side == 1 and signedDistance >= 2.0
                        wasFar := true
                    else if side == 1 and array.get(highs, i) < value - zone
                        wasFar := false
                    else if side == -1 and signedDistance <= -2.0
                        wasFar := true
                    else if side == -1 and array.get(lows, i) > value + zone
                        wasFar := false
                bool independent = i - lastTouch > 20
                if inZone and not previousInZone and wasFar and independent
                    float extreme = array.get(side == 1 ? highs : lows, i + 1)
                    for j = i + 1 to i + 10
                        extreme := side == 1 ? math.max(extreme, array.get(highs, j)) : math.min(extreme, array.get(lows, j))
                    array.push(bounces, side * (extreme - value) / atr)
                    float maximumBreach = side * (value - array.get(closes, i + 1)) / atr
                    for j = i + 1 to i + 5
                        maximumBreach := math.max(maximumBreach, side * (value - array.get(closes, j)) / atr)
                    holds += 1
                    held += maximumBreach <= 0.50 ? 1 : 0
                    lastTouch := i
                    wasFar := false
                previousInZone := inZone
    int touches = array.size(bounces)
    float score = 0.0
    bool ambiguousRounding = false
    if touches > 0
        float evidence = math.min(touches / 20.0, 1.0) * 25.0
        float holdRate = holds > 0 ? 100.0 * held / holds : 0.0
        float hold = math.max(0.0, math.min(holdRate, 100.0)) / 100.0 * 30.0
        float bounce = math.max(0.0, math.min(f_r18_median(bounces), 4.0)) / 4.0 * 25.0
        float quality = (evidence + hold + bounce) / 80.0 * 100.0
        float crossings = math.max(0.0, math.min(100.0 * crossCount / math.max(validBars, 1), 8.0))
        float cleanliness = 1.0 - 0.60 * crossings / 8.0
        [rounded, ambiguous] = f_r18_round_score(quality * cleanliness)
        score := rounded
        ambiguousRounding := ambiguous
    string levelClass = touches < 5 ? "insufficient_touches" : score >= 50.0 ? "strong_level" : score >= 38.0 ? "level" : score >= 27.0 ? "weak_level" : "not_level"
    [touches, score, levelClass, ambiguousRounding]

f_r18_native_snapshot(int requestedBars) =>
    int n = math.min(math.max(requestedBars, 1), bar_index + 1)
    array<float> closes = array.new<float>(n, na)
    array<float> highs = array.new<float>(n, na)
    array<float> lows = array.new<float>(n, na)
    array<float> volumes = array.new<float>(n, na)
    array<float> atrs = array.new<float>(n, na)
    bool valid = n >= 30
    float currentAtr = na
    for i = 0 to n - 1
        int offset = n - 1 - i
        float c = close[offset]
        float h = high[offset]
        float l = low[offset]
        float v = volume[offset]
        valid := valid and not na(c) and not na(h) and not na(l) and not na(v) and v >= 0.0
        array.set(closes, i, c)
        array.set(highs, i, h)
        array.set(lows, i, l)
        array.set(volumes, i, v)
        float tr = i == 0 ? h - l : math.max(h - l, math.abs(h - array.get(closes, i - 1)), math.abs(l - array.get(closes, i - 1)))
        currentAtr := i == 0 ? tr : (1.0 / 14.0) * tr + (1.0 - 1.0 / 14.0) * currentAtr
        if i >= 13
            array.set(atrs, i, currentAtr)
    valid := valid and not na(currentAtr) and currentAtr > 0.0
    // Historical qualification excludes a still-forming final candle.
    // Latest MA proximity and ATR nevertheless use the entire observed frame.
    int researchCount = n - (time_close > timenow ? 1 : 0)
    array<float> researchCloses = array.slice(closes, 0, researchCount)
    array<float> researchHighs = array.slice(highs, 0, researchCount)
    array<float> researchLows = array.slice(lows, 0, researchCount)
    array<float> researchAtrs = array.slice(atrs, 0, researchCount)
    array<R18QualifiedObservation> observations = array.new<R18QualifiedObservation>()
    int researched = 0
    bool roundingAmbiguous = false
    if valid
        array<string> types = array.from("SMA", "EMA", "WMA", "VWMA", "KAMA", "ALMA", "HMA")
        array<int> periods = array.from(5, 8, 10, 13, 20, 21, 22, 34, 50, 55, 89, 100, 144, 200, 233, 377)
        for typeIndex = 0 to array.size(types) - 1
            string kind = array.get(types, typeIndex)
            for periodIndex = 0 to array.size(periods) - 1
                int period = array.get(periods, periodIndex)
                array<float> moving = f_r18_ma(kind, closes, volumes, period)
                int validBars = 0
                int previousSign = 0
                int crossCount = 0
                for i = 0 to researchCount - 1
                    float value = array.get(moving, i)
                    if not na(value)
                        validBars += 1
                        float difference = array.get(closes, i) - value
                        if difference != 0.0
                            int sign = difference > 0.0 ? 1 : -1
                            if previousSign != 0 and sign != previousSign
                                crossCount += 1
                            previousSign := sign
                if validBars > 0
                    researched += 1
                    [supportTouches, supportScore, supportClass, supportAmbiguous] = f_r18_side_research(researchCloses, researchHighs, researchLows, array.slice(moving, 0, researchCount), researchAtrs, 1, validBars, crossCount)
                    [resistanceTouches, resistanceScore, resistanceClass, resistanceAmbiguous] = f_r18_side_research(researchCloses, researchHighs, researchLows, array.slice(moving, 0, researchCount), researchAtrs, -1, validBars, crossCount)
                    roundingAmbiguous := roundingAmbiguous or supportAmbiguous or resistanceAmbiguous
                    // Python max preserves the first (support) side for exact ties.
                    bool chooseResistance = resistanceScore > supportScore or (resistanceScore == supportScore and resistanceTouches > supportTouches)
                    string qualificationSide = chooseResistance ? "resistance" : "support"
                    float latest = array.get(moving, n - 1)
                    string activeSide = latest <= close ? "support" : "resistance"
                    if not na(latest) and qualificationSide == activeSide
                        array.push(observations, R18QualifiedObservation.new(kind, period, latest, qualificationSide, chooseResistance ? resistanceClass : supportClass, chooseResistance ? resistanceTouches : supportTouches, chooseResistance ? resistanceScore : supportScore, "ma_level_observation_v1-default", true))
    // No active levels matches Python provider's unavailable snapshot policy.
    bool snapshotKnown = valid and array.size(observations) > 0 and not roundingAmbiguous
    [known, support, resistance] = f_r18_select(snapshotKnown, syminfo.tickerid, timeframe.period, time_close, time_close + 1, true, observations, close, currentAtr, time_close, true)
    [known, array.size(support) > 0, array.size(resistance) > 0, researched, roundingAmbiguous]

// Native Python parity core for scanners 1-9. The old A-I formulas above are
// retained for chart display, but alarm packets use this dependency-aware core.
f_native_mean(array<float> values, int endIndex, int period) =>
    float total = 0.0
    bool valid = endIndex >= period - 1
    if valid
        for j = endIndex - period + 1 to endIndex
            float value = array.get(values, j)
            valid := valid and not na(value)
            total += na(value) ? 0.0 : value
    valid ? total / period : na

f_native_legacy_snapshot(int requestedBars) =>
    int n = math.min(math.max(requestedBars, 1), bar_index + 1)
    array<bool> flags = array.new<bool>(9, false)
    array<int> directions = array.new<int>(9, 0)
    array<bool> known = array.new<bool>(9, false)
    array<float> plans = array.new<float>(8, na)
    array<float> closes = array.new<float>(n, na)
    array<float> highs = array.new<float>(n, na)
    array<float> lows = array.new<float>(n, na)
    array<float> volumes = array.new<float>(n, na)
    array<float> e5 = array.new<float>(n, na)
    array<float> e8 = array.new<float>(n, na)
    array<float> e13 = array.new<float>(n, na)
    array<float> e21 = array.new<float>(n, na)
    array<float> e55 = array.new<float>(n, na)
    array<float> e200 = array.new<float>(n, na)
    array<float> macd = array.new<float>(n, na)
    array<float> macdSignal = array.new<float>(n, na)
    array<float> hist = array.new<float>(n, na)
    array<float> smi = array.new<float>(n, na)
    array<float> smiSignal = array.new<float>(n, na)
    array<float> rsi7 = array.new<float>(n, na)
    array<float> rsi14 = array.new<float>(n, na)
    array<float> wilder = array.new<float>(n, na)
    bool priceValid = true
    for i = 0 to n - 1
        int offset = n - 1 - i
        float c = close[offset]
        float h = high[offset]
        float l = low[offset]
        float v = volume[offset]
        array.set(closes, i, c)
        array.set(highs, i, h)
        array.set(lows, i, l)
        array.set(volumes, i, v)
        priceValid := priceValid and not na(c) and not na(h) and not na(l) and not na(open[offset]) and c > 0 and h > 0 and l > 0
    if priceValid
        float ema5 = na
        float ema8 = na
        float ema13 = na
        float ema21 = na
        float ema55 = na
        float ema200 = na
        float fast = na
        float slow = na
        float line = na
        float signal = na
        float g7 = na
        float l7 = na
        float g14 = na
        float l14 = na
        float wGainTotal = 0.0
        float wLossTotal = 0.0
        float wGain = na
        float wLoss = na
        float planTrTotal = 0.0
        float planAtr = na
        float num1 = na
        float num2 = na
        float den1 = na
        float den2 = na
        float smiSig = na
        bool smiSeed = false
        for i = 0 to n - 1
            float c = array.get(closes, i)
            float h = array.get(highs, i)
            float l = array.get(lows, i)
            if i == 0
                ema5 := c
                ema8 := c
                ema13 := c
                ema21 := c
                ema55 := c
                ema200 := c
                fast := c
                slow := c
                line := 0.0
                signal := line
            else
                ema5 := 2.0 / 6.0 * c + 4.0 / 6.0 * ema5
                ema8 := 2.0 / 9.0 * c + 7.0 / 9.0 * ema8
                ema13 := 2.0 / 14.0 * c + 12.0 / 14.0 * ema13
                ema21 := 2.0 / 22.0 * c + 20.0 / 22.0 * ema21
                ema55 := 2.0 / 56.0 * c + 54.0 / 56.0 * ema55
                ema200 := 2.0 / 201.0 * c + 199.0 / 201.0 * ema200
                fast := 2.0 / 13.0 * c + 11.0 / 13.0 * fast
                slow := 2.0 / 27.0 * c + 25.0 / 27.0 * slow
                line := fast - slow
                signal := 2.0 / 10.0 * line + 8.0 / 10.0 * signal
            array.set(e5, i, ema5)
            array.set(e8, i, ema8)
            array.set(e13, i, ema13)
            array.set(e21, i, ema21)
            array.set(e55, i, ema55)
            array.set(e200, i, ema200)
            array.set(macd, i, line)
            array.set(macdSignal, i, signal)
            array.set(hist, i, line - signal)
            if i > 0
                float previousClose = array.get(closes, i - 1)
                float change = c - previousClose
                float gain = math.max(change, 0.0)
                float loss = math.max(-change, 0.0)
                if i == 1
                    g7 := gain
                    l7 := loss
                    g14 := gain
                    l14 := loss
                else
                    g7 := gain / 7.0 + 6.0 / 7.0 * g7
                    l7 := loss / 7.0 + 6.0 / 7.0 * l7
                    g14 := gain / 14.0 + 13.0 / 14.0 * g14
                    l14 := loss / 14.0 + 13.0 / 14.0 * l14
                array.set(rsi7, i, l7 == 0.0 ? (g7 > 0.0 ? 100.0 : na) : 100.0 - 100.0 / (1.0 + g7 / l7))
                array.set(rsi14, i, l14 == 0.0 ? (g14 > 0.0 ? 100.0 : na) : 100.0 - 100.0 / (1.0 + g14 / l14))
                float tr = math.max(h - l, math.abs(h - previousClose), math.abs(l - previousClose))
                if i <= 14
                    wGainTotal += gain
                    wLossTotal += loss
                    planTrTotal += tr
                if i == 14
                    wGain := wGainTotal / 14.0
                    wLoss := wLossTotal / 14.0
                    planAtr := planTrTotal / 14.0
                else if i > 14
                    wGain := (13.0 * wGain + gain) / 14.0
                    wLoss := (13.0 * wLoss + loss) / 14.0
                    planAtr := (13.0 * planAtr + tr) / 14.0
                if i >= 14
                    array.set(wilder, i, wLoss == 0.0 ? (wGain > 0.0 ? 100.0 : 50.0) : 100.0 - 100.0 / (1.0 + wGain / wLoss))
            if i >= 9
                float highest = array.get(highs, i)
                float lowest = array.get(lows, i)
                for j = i - 9 to i
                    highest := math.max(highest, array.get(highs, j))
                    lowest := math.min(lowest, array.get(lows, j))
                float relative = c - (highest + lowest) / 2.0
                float width = highest - lowest
                if not smiSeed
                    num1 := relative
                    num2 := relative
                    den1 := width
                    den2 := width
                    smiSeed := true
                else
                    num1 := 0.5 * relative + 0.5 * num1
                    num2 := 0.5 * num1 + 0.5 * num2
                    den1 := 0.5 * width + 0.5 * den1
                    den2 := 0.5 * den1 + 0.5 * den2
                float smiValue = 200.0 * num2 / (den2 == 0.0 ? 0.000001 : den2)
                smiSig := na(smiSig) ? smiValue : 0.5 * smiValue + 0.5 * smiSig
                array.set(smi, i, smiValue)
                array.set(smiSignal, i, smiSig)
        if n >= 2
            bool macdReady = n >= 35
            bool smiReady = n >= 11 and not na(array.get(smi, n - 1)) and not na(array.get(smi, n - 2))
            bool wilderReady = n >= 16 and not na(array.get(wilder, n - 1)) and not na(array.get(wilder, n - 2))
            bool legacy7Ready = n >= 3 and not na(array.get(rsi7, n - 1)) and not na(array.get(rsi7, n - 2))
            bool legacy14Ready = n >= 3 and not na(array.get(rsi14, n - 1)) and not na(array.get(rsi14, n - 2))
            float vol20Mean = f_native_mean(volumes, n - 1, 20)
            float vol10Mean = f_native_mean(volumes, n - 1, 10)
            bool volume20Ready = not na(vol20Mean) and vol20Mean > 0.0
            bool volume10Ready = not na(vol10Mean) and vol10Mean > 0.0
            bool trendReady = n >= 200
            float price = array.get(closes, n - 1)
            float currentVolume = array.get(volumes, n - 1)
            float macdValue = array.get(macd, n - 1)
            float macdSignalValue = array.get(macdSignal, n - 1)
            float previousMacd = array.get(macd, n - 2)
            float previousMacdSignal = array.get(macdSignal, n - 2)
            float histogram = array.get(hist, n - 1)
            float previousHistogram = array.get(hist, n - 2)
            float smiValue = array.get(smi, n - 1)
            float smiSignalValue = array.get(smiSignal, n - 1)
            float previousSmi = array.get(smi, n - 2)
            float previousSmiSignal = array.get(smiSignal, n - 2)
            bool macdTrigger = (previousMacd <= previousMacdSignal and macdValue > macdSignalValue) or (macdValue > macdSignalValue and macdValue > previousMacd)
            bool smiTrigger = (previousSmi <= previousSmiSignal and smiValue > smiSignalValue) or (smiValue > smiSignalValue and smiValue > previousSmi)
            bool positiveCore = smiTrigger and smiValue > 0.0 and histogram > 0.0 and histogram > previousHistogram
            bool negativeCore = smiTrigger and smiValue < 0.0 and histogram < 0.0 and histogram > previousHistogram
            float currentRsi14 = array.get(wilder, n - 1)
            float previousRsi14 = array.get(wilder, n - 2)
            float currentLegacy14 = array.get(rsi14, n - 1)
            float previousLegacy14 = array.get(rsi14, n - 2)
            float currentLegacy7 = array.get(rsi7, n - 1)
            float previousLegacy7 = array.get(rsi7, n - 2)
            bool volume20High = volume20Ready and currentVolume > vol20Mean * 1.5
            bool volume10High = volume10Ready and currentVolume > vol10Mean * 1.5
            float sma200 = trendReady ? f_native_mean(closes, n - 1, 200) : na
            float sma5 = trendReady ? f_native_mean(closes, n - 1, 5) : na
            float sma8 = trendReady ? f_native_mean(closes, n - 1, 8) : na
            float sma21 = trendReady ? f_native_mean(closes, n - 1, 21) : na
            float sma50 = trendReady ? f_native_mean(closes, n - 1, 50) : na
            float sma55 = trendReady ? f_native_mean(closes, n - 1, 55) : na
            bool trendValuesReady = trendReady and not na(sma200) and not na(sma5) and not na(sma8) and not na(sma21) and not na(sma50) and not na(sma55)
            bool emaTrend = trendValuesReady and price > array.get(e21, n - 1) and price > array.get(e55, n - 1) and price > array.get(e200, n - 1) and array.get(e8, n - 1) > array.get(e13, n - 1) and array.get(e5, n - 1) > array.get(e8, n - 1) and array.get(e5, n - 1) > array.get(e13, n - 1) and ((array.get(e8, n - 2) <= array.get(e13, n - 2) and array.get(e8, n - 1) > array.get(e13, n - 1)) or (array.get(e8, n - 1) > array.get(e13, n - 1) and array.get(e8, n - 1) > array.get(e8, n - 2))) and ((array.get(e5, n - 2) <= array.get(e8, n - 2) and array.get(e5, n - 1) > array.get(e8, n - 1)) or (array.get(e5, n - 1) > array.get(e8, n - 1) and array.get(e5, n - 1) > array.get(e5, n - 2))) and ((array.get(e5, n - 2) <= array.get(e13, n - 2) and array.get(e5, n - 1) > array.get(e13, n - 1)) or (array.get(e5, n - 1) > array.get(e13, n - 1) and array.get(e5, n - 1) > array.get(e5, n - 2)))
            array.set(known, 0, macdReady and wilderReady)
            array.set(known, 1, macdReady and smiReady)
            array.set(known, 2, macdReady and smiReady and trendValuesReady and volume20Ready)
            array.set(known, 3, trendValuesReady and volume20Ready)
            array.set(known, 4, macdReady and legacy14Ready and volume20Ready)
            array.set(known, 5, macdReady and trendValuesReady and volume20Ready)
            array.set(known, 6, macdReady and smiReady and trendValuesReady and volume20Ready)
            array.set(known, 7, macdReady and smiReady and trendValuesReady and volume20Ready)
            array.set(known, 8, legacy7Ready and volume10Ready)
            array.set(flags, 0, array.get(known, 0) and currentRsi14 > 30.0 and macdValue > 0.0 and macdTrigger)
            array.set(flags, 1, array.get(known, 1) and n >= 200 and positiveCore)
            array.set(flags, 2, array.get(known, 2) and positiveCore and price > sma200 and volume20High)
            array.set(flags, 3, array.get(known, 3) and emaTrend and volume20High)
            array.set(flags, 4, array.get(known, 4) and ((previousLegacy14 <= 50.0 and currentLegacy14 > 50.0) or (currentLegacy14 > 50.0 and currentLegacy14 > previousLegacy14)) and currentLegacy14 < 70.0 and macdTrigger and volume20High)
            array.set(flags, 5, array.get(known, 5) and price > sma5 and price > sma8 and price > sma21 and price > sma50 and price > sma55 and price > sma200 and macdValue > 0.0 and macdTrigger and volume20High)
            array.set(flags, 6, array.get(known, 6) and negativeCore and price > sma200 and volume20High)
            array.set(flags, 7, array.get(known, 7) and negativeCore and not (price > sma200 and volume20High))
            array.set(flags, 8, array.get(known, 8) and n >= 30 and currentLegacy7 > 60.0 and ((previousLegacy7 <= 50.0 and currentLegacy7 > 50.0) or (currentLegacy7 > 50.0 and currentLegacy7 > previousLegacy7)) and volume10High)
            bool macdDown = (previousMacd >= previousMacdSignal and macdValue < macdSignalValue) or (macdValue < macdSignalValue and macdValue < previousMacd)
            bool smiDown = (previousSmi >= previousSmiSignal and smiValue < smiSignalValue) or (smiValue < smiSignalValue and smiValue < previousSmi)
            bool bearCore = smiDown and smiValue < 0.0 and histogram < 0.0 and histogram < previousHistogram
            bool bearRecovery = smiDown and smiValue > 0.0 and histogram > 0.0 and histogram < previousHistogram
            bool emaDown = trendValuesReady and price < array.get(e21, n - 1) and price < array.get(e55, n - 1) and price < array.get(e200, n - 1)
            emaDown := emaDown and ((array.get(e8, n - 2) >= array.get(e13, n - 2) and array.get(e8, n - 1) < array.get(e13, n - 1)) or (array.get(e8, n - 1) < array.get(e13, n - 1) and array.get(e8, n - 1) < array.get(e8, n - 2)))
            emaDown := emaDown and ((array.get(e5, n - 2) >= array.get(e8, n - 2) and array.get(e5, n - 1) < array.get(e8, n - 1)) or (array.get(e5, n - 1) < array.get(e8, n - 1) and array.get(e5, n - 1) < array.get(e5, n - 2)))
            emaDown := emaDown and ((array.get(e5, n - 2) >= array.get(e13, n - 2) and array.get(e5, n - 1) < array.get(e13, n - 1)) or (array.get(e5, n - 1) < array.get(e13, n - 1) and array.get(e5, n - 1) < array.get(e5, n - 2)))
            array<bool> bearFlags = array.new<bool>(9, false)
            array.set(bearFlags, 0, array.get(known, 0) and currentRsi14 < 70.0 and macdValue < 0.0 and macdDown)
            array.set(bearFlags, 1, array.get(known, 1) and n >= 200 and bearCore)
            array.set(bearFlags, 2, array.get(known, 2) and bearCore and price < sma200 and volume20High)
            array.set(bearFlags, 3, array.get(known, 3) and emaDown and volume20High)
            array.set(bearFlags, 4, array.get(known, 4) and ((previousLegacy14 >= 50.0 and currentLegacy14 < 50.0) or (currentLegacy14 < 50.0 and currentLegacy14 < previousLegacy14)) and currentLegacy14 > 30.0 and macdDown and volume20High)
            array.set(bearFlags, 5, array.get(known, 5) and price < sma5 and price < sma8 and price < sma21 and price < sma50 and price < sma55 and price < sma200 and macdValue < 0.0 and macdDown and volume20High)
            array.set(bearFlags, 6, array.get(known, 6) and bearRecovery and price < sma200 and volume20High)
            array.set(bearFlags, 7, array.get(known, 7) and bearRecovery and not (price < sma200 and volume20High))
            array.set(bearFlags, 8, array.get(known, 8) and n >= 30 and currentLegacy7 < 40.0 and ((previousLegacy7 >= 50.0 and currentLegacy7 < 50.0) or (currentLegacy7 < 50.0 and currentLegacy7 < previousLegacy7)) and volume10High)
            for i = 0 to 8
                if array.get(flags, i)
                    array.set(directions, i, 1)
                else if array.get(bearFlags, i)
                    array.set(flags, i, true)
                    array.set(directions, i, -1)
            if not na(planAtr) and planAtr > 0.0
                float recentLow = array.get(lows, n - 1)
                float recentHigh = array.get(highs, n - 1)
                for i = math.max(0, n - 7) to n - 1
                    recentLow := math.min(recentLow, array.get(lows, i))
                    recentHigh := math.max(recentHigh, array.get(highs, i))
                float longRisk = math.max(price - (recentLow - 0.2 * planAtr), 0.75 * planAtr)
                float shortRisk = math.max((recentHigh + 0.2 * planAtr) - price, 0.75 * planAtr)
                array.set(plans, 0, price - longRisk)
                array.set(plans, 1, price + longRisk)
                array.set(plans, 2, price + 2.0 * longRisk)
                array.set(plans, 3, price + 3.0 * longRisk)
                array.set(plans, 4, price + shortRisk)
                array.set(plans, 5, price - shortRisk)
                array.set(plans, 6, price - 2.0 * shortRisk)
                array.set(plans, 7, price - 3.0 * shortRisk)
    // Match Python: an invalid stop or any target invalidates the whole side.
    for sideIndex = 0 to 1
        bool validSide = true
        for levelIndex = sideIndex * 4 to sideIndex * 4 + 3
            float level = array.get(plans, levelIndex)
            validSide := validSide and not na(level) and level > 0.0
        if not validSide
            for levelIndex = sideIndex * 4 to sideIndex * 4 + 3
                array.set(plans, levelIndex, na)
    [flags, directions, known, plans]

// Latest observed states, including live candles. Ordinary BIST hourly chart.
atcEnabled = true
directionMode = input.string("AL ve SAT", "Tablo yönleri (bildirim yalnız AL)", options=["AL ve SAT", "Yalnız AL", "Yalnız SAT"], group="Genel")
atcComplex = input.bool(true, "10-17 hesaplarini etkinlestir (taslak)", group="Alpha Trend Cipher")
atcR18 = input.bool(true, "18 tarihsel MA arastirmasi (dogrulama)", group="Alpha Trend Cipher")
// Hard policy: BIST bearish analysis remains visible, but notifications are LONG only.
// No input can enable a bearish notification. Existing server alerts must be recreated.
notificationPolicy = "BIST bildirim: YALNIZ AL · Düşüş yalnız izleme"
humanStrengthening = input.bool(false, "Koşul sayısı artınca güçlenme bildir", group="Manuel Bildirim")
humanInitial = input.bool(false, "İlk taramada mevcut adayları da bildir", group="Manuel Bildirim")
humanMaxEvents = input.int(5, "Bir mesajdaki aday sayısı", minval=1, maxval=10, group="Manuel Bildirim")
humanMaxRuleNames = input.int(3, "Mesajda gösterilecek tarama adı", minval=1, maxval=18, group="Manuel Bildirim")
atcBars = input.int(600, "Python snapshot mum sayisi", minval=252, maxval=3000, group="Alpha Trend Cipher")
f_atc_bit(int mask, int id) =>
    int(math.floor(mask / math.pow(2.0, id - 1))) % 2 == 1
f_atc_ids(int mask) =>
    string s = "["
    int count = 0
    for id = 1 to 18
        if f_atc_bit(mask, id)
            s += (count > 0 ? "," : "") + str.tostring(id)
            count += 1
    s + "]"
f_atc_count(int mask) =>
    int count = 0
    for id = 1 to 18
        if f_atc_bit(mask, id)
            count += 1
    count
f_atc_stamp(int t) =>
    str.format_time(t, "yyyy-MM-dd'T'HH:mm:ss", "UTC") + "Z"
f_atc_tf() =>
    timeframe.period == "60" ? "1h" : timeframe.period == "240" ? "4h" : timeframe.isdaily and timeframe.multiplier == 1 ? "1d" : "1wk"
